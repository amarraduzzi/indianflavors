---
// Hub page for the "Découvrir" article series — see
// src/content/dish-guides.ts for the content model and the honesty note
// on why the hero uses a neutral mood image rather than a dish photo.
// Lists every published guide as a card; currently just Butter Chicken,
// grows automatically as more entries are added to dish-guides.ts.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../config/site.config';
import { dishGuides } from '../content/dish-guides';
import { t, localizedPath, arrow, type Language } from '../i18n/languages';
import { place } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name } = siteConfig.identity;
const primaryKeyword = t(siteConfig.identity.primaryKeyword, lang);
const city = t(place.city, lang);

const copy = {
  metaTitle: {
    fr: `Découvrir la cuisine indienne — ${primaryKeyword} à ${city} | ${name}`,
    en: `Discover Indian Cuisine — ${primaryKeyword} in ${city} | ${name}`,
    ar: `اكتشف المطبخ الهندي — ${primaryKeyword} في ${city} | ${name}`,
  },
  metaDescription: {
    fr: `Origine, histoire et préparation des grands classiques de la cuisine indienne, expliqués simplement par ${name}, ${primaryKeyword} à ${city}.`,
    en: `The origin, history and preparation of Indian cuisine's great classics, explained simply by ${name}, ${primaryKeyword} in ${city}.`,
    ar: `أصل وتاريخ وطريقة تحضير أشهر أطباق المطبخ الهندي، مشروحة ببساطة من طرف ${name}, ${primaryKeyword} في ${city}.`,
  },
  kicker: { fr: 'Le guide des plats', en: 'The dish guide', ar: 'دليل الأطباق' },
  heroTitle: { fr: 'Découvrir la cuisine indienne', en: 'Discover Indian cuisine', ar: 'اكتشف المطبخ الهندي' },
  heroAlt: {
    fr: 'Motif décoratif orientaliste, ambiance du restaurant',
    en: 'Decorative Moorish pattern, restaurant ambiance',
    ar: 'نقش زخرفي مغربي، أجواء المطعم',
  },
  // Short version lives in the hero itself (PageHero's subtitle — same
  // small, unobtrusive treatment every other interior page uses, see
  // MenuContent/ReservationContent). The old design put this same copy in
  // a full-width `.pull-quote` block below the hero — a style meant for a
  // single short line (see global.css), not a 3-sentence paragraph, which
  // is exactly why it read oversized and out of place. `intro` below is
  // the longer version, kept as normal body copy under the card grid.
  heroSubtitle: {
    fr: "La cuisine indienne reste souvent moins connue au Maroc — cette section vous fait découvrir chaque plat : origine, préparation et anecdotes.",
    en: 'Indian cuisine is often less familiar in Morocco — this section walks you through each dish: its origin, preparation and fun facts.',
    ar: 'لا يزال المطبخ الهندي أقل شهرة في المغرب — يقدّم لكم هذا القسم كل طبق: أصله، تحضيره، ومعلومات ممتعة عنه.',
  },
  intro: {
    fr: "Beaucoup de nos clients découvrent certains plats pour la première fois chez nous. Cette section leur est dédiée : d'où vient chaque plat, comment il est préparé traditionnellement, et quelques anecdotes pour l'apprécier encore davantage à table.",
    en: 'Many of our guests try certain dishes here for the very first time. This section is for them: where each dish comes from, how it\'s traditionally made, and a few fun facts to enjoy even more at the table.',
    ar: 'يكتشف الكثير من زبائننا بعض الأطباق لأول مرة عندنا. هذا القسم مخصص لهم: من أين يأتي كل طبق، وكيف يُحضَّر تقليديًا، وبعض المعلومات الممتعة للاستمتاع به أكثر على الطاولة.',
  },
  readArticle: { fr: "Lire l'article", en: 'Read the article', ar: 'اقرأ المقال' },
  comingSoon: {
    fr: "D'autres plats de notre carte rejoindront bientôt cette section.",
    en: 'More dishes from our menu will join this section soon.',
    ar: 'ستنضم المزيد من أطباق قائمتنا إلى هذا القسم قريبًا.',
  },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const path = localizedPath('/decouvrir', lang);
---
<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
>
  <PageHero
    kicker={t(copy.kicker, lang)}
    title={t(copy.heroTitle, lang)}
    subtitle={t(copy.heroSubtitle, lang)}
    image="/images/mood-tile.webp"
    alt={t(copy.heroAlt, lang)}
  />

  <section class="max-w-3xl mx-auto px-5 sm:px-8 pt-12 sm:pt-14 pb-2" data-reveal>
    <p class="text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">
      {t(copy.intro, lang)}
    </p>
  </section>

  <!-- Each card now opens with the dish's own real photo (guide.heroImage —
       same photo used at the top of its article) instead of being pure
       text — a text-only card grid was the flattest, least appetizing
       thing on the whole site given every other page leads with food
       photography. Falls back to the neutral mood-tile.webp for any
       future guide that doesn't have a real photo yet (same honesty rule
       as everywhere else: never a mismatched dish photo standing in). -->
  <section class="max-w-5xl mx-auto px-5 sm:px-8 pt-8 pb-20">
    <div class="grid sm:grid-cols-2 gap-6">
      {dishGuides.map((guide, i) => (
        <a
          href={localizedPath(`/decouvrir/${guide.slug}`, lang)}
          class="card-lift block rounded-2xl overflow-hidden"
          style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${i * 100}ms`}
          data-reveal
        >
          <div class="photo-frame aspect-[4/3]">
            <img
              src={guide.heroImage ?? '/images/mood-tile.webp'}
              alt={guide.heroAlt ? t(guide.heroAlt, lang) : t(guide.title, lang)}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="p-6 sm:p-8">
            <span class="block text-[10px] font-bold uppercase tracking-[0.2em] mb-2" style="color: var(--color-accent)">
              {t(guide.kicker, lang)}
            </span>
            <h2 class="font-display text-2xl font-semibold mb-3" style="color: var(--color-text-primary)">
              {t(guide.title, lang)}
            </h2>
            <p class="text-sm leading-relaxed mb-4" style="color: var(--color-text-muted)">
              {t(guide.teaser, lang)}
            </p>
            <span class="inline-flex items-center gap-1.5 text-sm font-bold" style="color: var(--color-accent)">
              {t(copy.readArticle, lang)} {arrow(lang)}
            </span>
          </div>
        </a>
      ))}
    </div>

    <p class="mt-8 text-sm text-center" style="color: var(--color-text-muted)">
      {t(copy.comingSoon, lang)}
    </p>
  </section>
</Layout>
