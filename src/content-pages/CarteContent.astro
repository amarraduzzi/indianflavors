---
// Tafelkaart via QR-code — nog steeds géén hero-afbeelding of Ken Burns-effect
// zoals MenuContent.astro (snel laden, snel scannen). Elk gerecht toont een
// compacte rij (foto/placeholder, naam, badge, prijs) met een duidelijk
// "i" info-icoon; een tik erop opent een ECHT fullscreen infoscherm (native
// <dialog>, dus toegankelijk + Escape/backdrop-klik werkt gratis mee) met
// grote foto, het verhaal van het gerecht en de ingrediënten. Dit *is* het
// educatieve stuk van de kaart: de doelgroep kent de Indiase keuken niet, dus
// dit scherm moet overtuigen, niet alleen informeren.
// Toont ALLEEN de restaurantprijs (zie full-menu.ts voor de bron).
//
// v3 (modal-herontwerp, vervangt de v2 inline-accordion): elk gerecht heeft
// nu een eigen <dialog id="dish-...">, geopend via vanilla JS
// (`astro:page-load`, zelfde patroon als Header.astro). Geen client
// framework nodig — <dialog>.showModal() geeft focus-trap, Escape-to-close
// en een ::backdrop gratis; de fade/scale-animatie zelf gaat via een CSS-
// klasse die na showModal() wordt toegevoegd (dialogs animeren niet
// vanzelf bij het openen zonder @starting-style, en dat heeft nog geen
// brede iOS Safari-steun).
//
// Volgt hetzelfde i18n/Layout-patroon als MenuContent.astro zodat dit naast
// de bestaande site past zonder iets anders te breken.

import Layout from '../layouts/Layout.astro';
import Ornament from '../components/Ornament.astro';
import { siteConfig } from '../config/site.config';
import { fullMenu } from '../content/full-menu';
import { t, localizedPath, type Language } from '../i18n/languages';
import { place, common } from '../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = 'fr' } = Astro.props;
const { name } = siteConfig.identity;
const city = t(place.city, lang);

const copy = {
  metaTitle: {
    fr: `Notre carte — ${name}`,
    en: `Our menu — ${name}`,
    ar: `قائمتنا — ${name}`,
  },
  metaDescription: {
    fr: `La carte complète de ${name} à ${city}, à consulter sur place.`,
    en: `The full menu of ${name} in ${city}, for dine-in guests.`,
    ar: `القائمة الكاملة لـ${name} في ${city}، للضيوف داخل المطعم.`,
  },
  heroTitle: { fr: 'Notre carte', en: 'Our menu', ar: 'قائمتنا' },
  heroSubtitle: {
    fr: 'Prix service à table. Une question sur un plat ? Notre équipe se fera un plaisir de vous conseiller.',
    en: 'Dine-in prices. Questions about a dish? Our team is happy to help.',
    ar: 'أسعار الخدمة داخل المطعم. لديك سؤال عن طبق؟ فريقنا سعيد بمساعدتك.',
  },
  vegLabel: { fr: 'Végétarien', en: 'Vegetarian', ar: 'نباتي' },
  ingredientsLabel: { fr: 'Ingrédients', en: 'Ingredients', ar: 'المكوّنات' },
  infoLabel: { fr: 'Voir le plat', en: 'View dish', ar: 'عرض الطبق' },
  closeLabel: { fr: 'Fermer', en: 'Close', ar: 'إغلاق' },
  searchPlaceholder: {
    fr: 'Rechercher un plat (ex. Biryani, Naan)…',
    en: 'Search a dish (e.g. Biryani, Naan)…',
    ar: 'ابحث عن طبق (مثال: برياني، نان)…',
  },
  searchClear: { fr: 'Effacer la recherche', en: 'Clear search', ar: 'مسح البحث' },
  searchNoResults: {
    fr: 'Aucun plat ne correspond à votre recherche.',
    en: 'No dish matches your search.',
    ar: 'لا يوجد طبق يطابق بحثك.',
  },
  backToSearch: { fr: 'Retour à la recherche', en: 'Back to search', ar: 'العودة إلى البحث' },
  visitWebsite: {
    fr: 'Envie d’en savoir plus sur nous ?',
    en: 'Want to know more about us?',
    ar: 'هل تريد معرفة المزيد عنا؟',
  },
  visitWebsiteCta: { fr: 'Visitez notre site', en: 'Visit our website', ar: 'زوروا موقعنا' },
  // ---- Bestellen aan tafel: mandje verstuurd naar het personeelsscherm
  // (zelfde Supabase `orders`-tabel als de order-site) ----
  addToOrder: { fr: 'Ajouter', en: 'Add', ar: 'إضافة' },
  decreaseQty: { fr: 'Diminuer la quantité', en: 'Decrease quantity', ar: 'إنقاص الكمية' },
  increaseQty: { fr: 'Augmenter la quantité', en: 'Increase quantity', ar: 'زيادة الكمية' },
  cartBarLabel: { fr: 'Voir ma commande', en: 'View my order', ar: 'عرض طلبي' },
  cartTitle: { fr: 'Ma commande', en: 'My order', ar: 'طلبي' },
  cartEmpty: {
    fr: 'Votre panier est vide. Touchez « Ajouter » sur un plat pour commencer.',
    en: 'Your cart is empty. Tap "Add" on a dish to get started.',
    ar: 'سلتك فارغة. اضغط على "إضافة" بجانب أي طبق للبدء.',
  },
  cartItemTotal: { fr: 'Sous-total', en: 'Subtotal', ar: 'المجموع الفرعي' },
  removeItem: { fr: 'Retirer', en: 'Remove', ar: 'إزالة' },
  tableNumberLabel: { fr: 'Numéro de table', en: 'Table number', ar: 'رقم الطاولة' },
  tableNumberPlaceholder: { fr: 'Ex : 5', en: 'e.g. 5', ar: 'مثال: 5' },
  tableNumberRequired: {
    fr: 'Merci d’indiquer votre numéro de table.',
    en: 'Please enter your table number.',
    ar: 'يرجى إدخال رقم طاولتك.',
  },
  tablePrefix: { fr: 'Table', en: 'Table', ar: 'طاولة' },
  notesLabel: { fr: 'Remarque (facultatif)', en: 'Note (optional)', ar: 'ملاحظة (اختياري)' },
  notesPlaceholder: {
    fr: 'Ex : sans piment, allergie…',
    en: 'e.g. no chili, allergy…',
    ar: 'مثال: بدون فلفل حار، حساسية…',
  },
  submitOrder: { fr: 'Envoyer la commande', en: 'Send order', ar: 'إرسال الطلب' },
  sendingOrder: { fr: 'Envoi en cours…', en: 'Sending…', ar: 'جارٍ الإرسال…' },
  orderSuccessTitle: { fr: 'Commande envoyée !', en: 'Order sent!', ar: 'تم إرسال الطلب!' },
  orderSuccessBody: {
    fr: 'Notre équipe a bien reçu votre commande et arrive à votre table.',
    en: 'Our team has received your order and is on their way to your table.',
    ar: 'استلم فريقنا طلبك وهو في طريقه إلى طاولتك.',
  },
  orderSuccessClose: { fr: 'Continuer à parcourir la carte', en: 'Keep browsing the menu', ar: 'متابعة تصفح القائمة' },
  // ---- Google-avis: twee plekken, zie de uitleg bij elke plek in de markup
  // hieronder voor waarom precies dáár. ----
  reviewSuccessPrompt: {
    fr: 'Vous appréciez votre visite ?',
    en: 'Enjoying your visit?',
    ar: 'هل تستمتعون بزيارتكم؟',
  },
  reviewSuccessCta: { fr: 'Laissez-nous un avis Google', en: 'Leave us a Google review', ar: 'اتركوا لنا تقييمًا على Google' },
  reviewFooterCta: { fr: 'Laisser un avis Google', en: 'Leave a Google review', ar: 'اتركوا تقييمًا على Google' },
  orderErrorBody: {
    fr: 'Impossible d’envoyer la commande. Vérifiez votre connexion et réessayez, ou appelez notre équipe.',
    en: 'Could not send the order. Check your connection and try again, or call our team over.',
    ar: 'تعذّر إرسال الطلب. تحقّق من اتصالك وحاول مجددًا، أو نادِ فريقنا.',
  },
  orderRetry: { fr: 'Réessayer', en: 'Try again', ar: 'إعادة المحاولة' },
  cartClose: { fr: 'Fermer', en: 'Close', ar: 'إغلاق' },
  cartClearAll: { fr: 'Vider le panier', en: 'Empty cart', ar: 'إفراغ السلة' },
  cartClearConfirm: {
    fr: 'Vider tout le panier ?',
    en: 'Empty the whole cart?',
    ar: 'هل تريد إفراغ السلة بالكامل؟',
  },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const path = localizedPath('/carte', lang);

// Eén klein lijn-icoon per categorie — puur decoratief (aria-hidden), dus
// geen vertaling nodig. Gekoppeld op het FR-label (de brontaal van de data)
// zodat dit blijft werken ongeacht welke taal er gerenderd wordt. Onbekende
// categorieën vallen terug op het bestek-icoon, dus dit breekt nooit als er
// later een categorie bijkomt.
const categoryIcons: Record<string, string> = {
  Soupes: 'M4 12h16M4 12a8 8 0 0016 0M4 12l1-5h14l1 5M9 4v2M12 3v2.5M15 4v2',
  'Entrées Végétariennes': 'M12 21c-4-2-7-6-7-11a7 7 0 0114 0c0 5-3 9-7 11z',
  'Entrées Non-Végétariennes': 'M8 3c2 1 3 3 3 5l7 7a2.5 2.5 0 01-3.5 3.5L7 11c-2 0-4-1-5-3',
  'Plats Principaux': 'M4 13a8 8 0 0016 0H4z M12 3v2 M8 4l.5 1.5 M16 4l-.5 1.5',
  'Spécialités Tandoori': 'M12 3c-1.5 3-4.5 4.5-4.5 8.5a4.5 4.5 0 009 0C16.5 7.5 13.5 6 12 3z',
  'Plats Principaux Végétariens': 'M12 21c-4-2-7-6-7-11a7 7 0 0114 0c0 5-3 9-7 11z',
  "Biryani Dum d'Hyderabad": 'M5 11h14l-1 8a2 2 0 01-2 2H8a2 2 0 01-2-2l-1-8z M4 11a8 3 0 0016 0',
  'Naan, Riz & Nouilles': 'M4 8c4-3 12-3 16 0-2 2-2 5 0 7-4 3-12 3-16 0 2-2 2-5 0-7z',
  Desserts: 'M12 3l1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8L12 3z M6 18h12',
  'Boissons Fraîches': 'M7 4h10l-1 15a2 2 0 01-2 2h-4a2 2 0 01-2-2L7 4z M6 4h12 M9 9h6',
  'Boissons Chaudes': 'M4 9h13v5a4 4 0 01-4 4H8a4 4 0 01-4-4V9z M17 10h1.5a2 2 0 010 4H17 M8 4c0 1-1 1-1 2 M12 4c0 1-1 1-1 2',
};
const fallbackIconPath = 'M8 3v6a2 2 0 002 2h0a2 2 0 002-2V3 M12 3v18 M16 3c-1.5 0-3 1.5-3 4s1.5 4 3 4v10';

// Stabiele, url-veilige id per gerecht voor de dialog (fr-naam is uniek
// genoeg in deze kaart; géén diakrieten/spaties toegestaan in een id).
function dishId(categoryIndex: number, itemIndex: number, itemName: string): string {
  const slug = itemName
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
  return `dish-${categoryIndex}-${itemIndex}-${slug}`;
}

// Zelfde soort stabiele id, maar dan voor de categorie-secties zelf \u2014 het
// ankerpunt voor de horizontaal swipebare chip-rij hieronder (op het FR-
// label, om dezelfde reden als categoryIcons hierboven).
function categoryId(categoryIndex: number, labelFr: string): string {
  const slug = labelFr
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
  return `cat-${categoryIndex}-${slug}`;
}
---

<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
  minimalHeader
  showFooter={false}
  showWhatsApp={false}
>
  <!-- Compacte, tekstuele hero — geen beeld, laadt razendsnel op mobiel. -->
  <section class="max-w-3xl mx-auto px-5 sm:px-8 pt-8 pb-6 text-center">
    <!-- 100% Halal-embleem: een echt medaillon i.p.v. de tekst-pil die
         elders op de site staat (zie HomeContent.astro) — de gast vraagt
         hier expliciet om iets VISUEELS, meteen bovenaan, dus dit is geen
         hergebruik van die pil maar een eigen zegel: dubbele ring, wassende
         maan in het midden, "100% HALAL" gebogen langs de bovenkant en het
         Arabische woord "حلال" eronder voor herkenbaarheid ook zonder de
         Latijnse tekst te hoeven lezen. -->
    <div class="flex justify-center mb-4" data-reveal>
      <svg
        width="84"
        height="84"
        viewBox="0 0 120 120"
        class="halal-seal"
        role="img"
        aria-label={t(common.halalBadge, lang)}
      >
        <defs>
          <path id="halal-arc" d="M20,62 A40,40 0 0 1 100,62" fill="none" />
          <mask id="halal-crescent-mask">
            <rect x="0" y="0" width="120" height="120" fill="white" />
            <circle cx="65" cy="53" r="10.5" fill="black" />
          </mask>
        </defs>
        <circle cx="60" cy="60" r="55" fill="none" stroke="var(--color-accent)" stroke-width="1.4" opacity="0.9" />
        <circle cx="60" cy="60" r="48" fill="none" stroke="var(--color-accent)" stroke-width="1" opacity="0.5" />
        <circle cx="60" cy="53" r="11.5" fill="var(--color-accent)" mask="url(#halal-crescent-mask)" />
        <!-- direction="ltr" + unicode-bidi hier is bewust: op de /ar/carte/
             pagina staat dir="rtl" op <html>, en zonder deze override
             draait de browser "100% HALAL" om tot "HALAL 100%" langs de
             boog — dit is een universele/Latijnse zegeltekst, die moet er
             in alle drie de talen identiek uitzien. -->
        <text
          font-size="12.5"
          font-weight="800"
          letter-spacing="2.5"
          fill="var(--color-accent)"
          direction="ltr"
          style="unicode-bidi: bidi-override;"
        >
          <textPath href="#halal-arc" startOffset="50%" text-anchor="middle">100% HALAL</textPath>
        </text>
        <circle cx="42" cy="88" r="1.6" fill="var(--color-accent)" opacity="0.7" />
        <circle cx="78" cy="88" r="1.6" fill="var(--color-accent)" opacity="0.7" />
        <text
          x="60"
          y="93"
          text-anchor="middle"
          font-size="15"
          font-family="'Noto Naskh Arabic', serif"
          font-weight="700"
          fill="var(--color-accent)"
        >
          حلال
        </text>
      </svg>
    </div>
    <h1 class="font-display text-3xl sm:text-4xl font-semibold" style="color: var(--color-text-primary)">
      {t(copy.heroTitle, lang)}
    </h1>
    <p class="mt-3 text-sm sm:text-base" style="color: var(--color-text-muted)">
      {t(copy.heroSubtitle, lang)}
    </p>
  </section>

  <!-- Zoekbalk — sticky onder de header, zelfde idee als de "Glovo-stijl"
       bestelsite maar met het donker/goud vocabulaire van déze site
       i.p.v. losse felle kleuren. Puur client-side filteren op naam (geen
       reload, geen server nodig): elke gerecht-knop draagt zijn naam in
       data-dish-name, het script hieronder verbergt niet-matchende rijen
       én hele categorieën die daardoor leeg blijven. Dit is ook het
       "terug naar boven"-ankerpunt voor de linkjes onder elke categorie. -->
  <div
    id="carte-search-bar"
    class="sticky top-16 sm:top-20 z-30"
    style="background-color: color-mix(in srgb, var(--color-surface) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--color-border)"
  >
    <div class="max-w-3xl mx-auto px-5 sm:px-8 py-3">
      <div class="relative">
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="absolute top-1/2 -translate-y-1/2 pointer-events-none rtl:right-4 ltr:left-4"
          style="color: var(--color-accent)"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          id="carte-search-input"
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder={t(copy.searchPlaceholder, lang)}
          class="carte-search-input w-full rounded-full text-sm rtl:pr-11 rtl:pl-4 ltr:pl-11 ltr:pr-4 py-3"
          style="background-color: var(--color-surface-muted); border: 1px solid var(--color-border); color: var(--color-text-primary)"
        />
        <button
          type="button"
          id="carte-search-clear"
          class="hidden absolute top-1/2 -translate-y-1/2 items-center justify-center w-6 h-6 rounded-full rtl:left-3 ltr:right-3"
          style="background-color: var(--color-border); color: var(--color-text-primary)"
          aria-label={t(copy.searchClear, lang)}
        >
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
            <line x1="5" y1="5" x2="19" y2="19" />
            <line x1="19" y1="5" x2="5" y2="19" />
          </svg>
        </button>
      </div>

      <!-- Categorie-chips: horizontaal swipebaar (native overflow-scroll,
           dus vinger-swipe werkt zonder JS), zelfde idee als de
           bestelsite's categorie-pillen maar in het donker/goud vocabulaire
           van déze site. Springt naar de sectie (native anchor-scroll,
           scroll-margin-top op elke sectie compenseert voor deze sticky
           balk) en licht de categorie op waar de gast net aan het scrollen
           is via IntersectionObserver in het script hieronder. -->
      <div class="carte-chip-row mt-3" role="tablist" aria-label={t(copy.heroTitle, lang)}>
        {fullMenu.map((category, ci) => {
          const cid = categoryId(ci, category.label.fr);
          return (
            <a
              href={`#${cid}`}
              class="carte-chip"
              data-chip-target={cid}
              role="tab"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={categoryIcons[category.label.fr] ?? fallbackIconPath} />
              </svg>
              <span>{t(category.label, lang)}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Leeg-resultaat melding — verborgen totdat het script hem toont. -->
  <p id="carte-search-empty" class="hidden max-w-3xl mx-auto px-5 sm:px-8 py-8 text-center text-sm" style="color: var(--color-text-muted)">
    {t(copy.searchNoResults, lang)}
  </p>

  {fullMenu.map((category, ci) => (
    <section
      id={categoryId(ci, category.label.fr)}
      class="carte-category-section max-w-3xl mx-auto px-5 sm:px-8 py-6"
      data-carte-category
    >
      <h2
        class="font-display text-xl font-semibold mb-1 flex items-center gap-3"
        style="color: var(--color-text-primary)"
      >
        <span
          class="flex items-center justify-center w-9 h-9 rounded-full shrink-0"
          style="background-color: color-mix(in srgb, var(--color-accent) 14%, transparent)"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent)" aria-hidden="true">
            <path d={categoryIcons[category.label.fr] ?? fallbackIconPath} />
          </svg>
        </span>
        {t(category.label, lang)}
      </h2>
      <Ornament />
      <div class="flex flex-col gap-3 mt-2">
        {category.items.map((item, ii) => {
          const id = dishId(ci, ii, item.name);
          return (
            <>
              <!-- Kaart per gerecht: bovenste deel is de trigger die de
                   infodialog opent (button-in-button mag niet in HTML, dus
                   de bestel-stepper hieronder staat als sibling, niet
                   genest, in dezelfde kaart-wrapper). -->
              <div
                class="dish-card rounded-2xl"
                style={`background-color: var(--color-surface); border: 1px solid var(--color-border); box-shadow: 0 1px 0 rgba(255,255,255,0.04) inset, 0 10px 24px -16px rgba(0,0,0,0.6)${item.image ? ', 0 0 0 1px color-mix(in srgb, var(--color-accent) 8%, transparent)' : ''}`}
              >
              <button
                type="button"
                class="dish-trigger group flex items-center justify-between gap-4 px-4 pt-3 pb-2 text-left w-full"
                data-dialog-target={id}
                data-dish-name={item.name}
                aria-haspopup="dialog"
              >
                <span class="flex items-center gap-3.5 min-w-0">
                  {item.image ? (
                    <!-- Dunne goud-gradient "lijst" om de foto: het accent draagt
                         nu ook de fotografie, niet alleen tekst en badges. -->
                    <span
                      class="rounded-xl p-[2px] shrink-0"
                      style="background: linear-gradient(135deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 25%, transparent))"
                    >
                      <img
                        src={item.image}
                        alt=""
                        loading="lazy"
                        class="w-20 h-20 sm:w-24 sm:h-24 rounded-[10px] object-cover block"
                      />
                    </span>
                  ) : (
                    <span
                      class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl shrink-0 flex items-center justify-center"
                      style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 22%, transparent), color-mix(in srgb, var(--color-primary-dark) 35%, var(--color-surface)))"
                      aria-hidden="true"
                    >
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent)">
                        <path d={fallbackIconPath} />
                      </svg>
                    </span>
                  )}
                  <span class="min-w-0">
                    <span class="block font-semibold" style="color: var(--color-text-primary)">
                      {item.name}
                      {item.vegetarian && <span class="text-xs align-middle ml-1" title={t(copy.vegLabel, lang)}>🌱</span>}
                    </span>
                    {item.tags && item.tags.length > 0 && (
                      <span class="flex flex-wrap gap-1 mt-1">
                        {item.tags.map((tag) => (
                          <span
                            class="text-[10px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded-full"
                            style="color: var(--color-background); background-color: var(--color-accent)"
                          >
                            {t(tag, lang)}
                          </span>
                        ))}
                      </span>
                    )}
                  </span>
                </span>
                <!-- Prijs + info samen in één goud-getinte pil i.p.v. losse
                     elementen: het accent krijgt hier een duidelijker "vorm"
                     in plaats van alleen gekleurde tekst. -->
                <span
                  class="flex items-center gap-2 pl-3 pr-1 py-1 rounded-full shrink-0"
                  style="background-color: color-mix(in srgb, var(--color-accent) 10%, transparent); border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent)"
                >
                  <span class="font-bold text-sm whitespace-nowrap" style="color: var(--color-accent)">{item.priceMAD} MAD</span>
                  <!-- Info-icoon: de expliciete uitnodiging om het gerecht te openen. -->
                  <span
                    class="flex items-center justify-center w-7 h-7 rounded-full transition-transform duration-150 group-active:scale-90 shrink-0"
                    style="background-color: var(--color-accent); color: var(--color-background)"
                    aria-hidden="true"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                      <circle cx="12" cy="12" r="10" stroke-width="1.6" />
                      <line x1="12" y1="11" x2="12" y2="16.5" />
                      <circle cx="12" cy="7.7" r="1.1" fill="currentColor" stroke="none" />
                    </svg>
                  </span>
                </span>
                <span class="sr-only">{t(copy.infoLabel, lang)}</span>
              </button>

              <!-- Bestel-stepper: apart van de infoknop hierboven, zodat een
                   tik hierop niet ook nog het infoscherm opent. Standaard
                   toont dit alleen de "Ajouter"-pil; zodra de gast tikt
                   verschijnt de volledige −/aantal/+ stepper (zie CSS,
                   gestuurd via data-qty op de wrapper). -->
              <div
                class="qty-stepper flex items-center justify-between px-4 pb-3 pt-2"
                style="border-top: 1px dashed var(--color-border)"
                data-qty-stepper
                data-qty="0"
                data-item-name={item.name}
                data-item-price={item.priceMAD}
              >
                <span class="text-[11px] font-semibold uppercase tracking-wide" style="color: var(--color-text-muted)">
                  {t(copy.addToOrder, lang)}
                </span>
                <button type="button" class="qty-add-btn" data-qty-add>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                  {t(copy.addToOrder, lang)}
                </button>
                <div class="qty-full items-center gap-3">
                  <button type="button" class="qty-btn" data-qty-minus aria-label={t(copy.decreaseQty, lang)}>−</button>
                  <span class="qty-value font-bold text-sm" data-qty-value style="color: var(--color-text-primary)">0</span>
                  <button type="button" class="qty-btn" data-qty-plus aria-label={t(copy.increaseQty, lang)}>+</button>
                </div>
              </div>
              </div>

              <!-- Fullscreen infoscherm voor dit gerecht. -->
              <dialog id={id} class="dish-dialog" aria-labelledby={`${id}-title`}>
                <div class="dish-dialog-card">
                  <div class="dish-dialog-hero">
                    {item.image ? (
                      <img src={item.image} alt={item.name} class="dish-dialog-hero-img" />
                    ) : (
                      <div
                        class="dish-dialog-hero-img flex items-center justify-center"
                        style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 24%, transparent), color-mix(in srgb, var(--color-primary-dark) 40%, var(--color-surface)))"
                        aria-hidden="true"
                      >
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent); opacity: 0.75">
                          <path d={fallbackIconPath} />
                        </svg>
                      </div>
                    )}
                    <div class="dish-dialog-hero-fade" aria-hidden="true"></div>
                    <button type="button" class="dish-dialog-close" data-dialog-close aria-label={t(copy.closeLabel, lang)}>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                        <line x1="5" y1="5" x2="19" y2="19" />
                        <line x1="19" y1="5" x2="5" y2="19" />
                      </svg>
                    </button>
                    <div class="dish-dialog-hero-caption">
                      {item.tags && item.tags.length > 0 && (
                        <span class="flex flex-wrap gap-1 mb-2">
                          {item.tags.map((tag) => (
                            <span
                              class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full"
                              style="color: var(--color-background); background-color: var(--color-accent)"
                            >
                              {t(tag, lang)}
                            </span>
                          ))}
                        </span>
                      )}
                      <h3 id={`${id}-title`} class="font-display text-2xl sm:text-3xl font-semibold" style="color: #fff">
                        {item.name}
                        {item.vegetarian && <span class="text-base align-middle ml-1" title={t(copy.vegLabel, lang)}>🌱</span>}
                      </h3>
                      <span
                        class="inline-block mt-1 font-bold text-sm px-3 py-1 rounded-full"
                        style="color: var(--color-accent); background-color: rgba(0,0,0,0.35); border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent)"
                      >
                        {item.priceMAD} MAD
                      </span>
                    </div>
                  </div>
                  <div class="dish-dialog-body">
                    <p class="text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">
                      {t(item.story ?? item.description, lang)}
                    </p>
                    {item.ingredients && (
                      <div class="mt-4 pt-4" style="border-top: 1px solid var(--color-border)">
                        <span class="text-xs font-bold uppercase tracking-wide" style="color: var(--color-accent)">
                          {t(copy.ingredientsLabel, lang)}
                        </span>
                        <p class="text-sm mt-1.5" style="color: var(--color-text-muted)">
                          {t(item.ingredients, lang)}
                        </p>
                      </div>
                    )}
                  </div>
                </div>
              </dialog>
            </>
          );
        })}
      </div>
      <!-- Terug-naar-zoeken: elke categorie eindigt met dezelfde stijlvolle
           uitnodiging om weer boven aan de zoekbalk te beginnen, i.p.v. dat
           de gast helemaal terug moet scrollen. -->
      <div class="flex justify-center mt-5">
        <a href="#top" class="back-to-search-link" data-back-to-search>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="19" x2="12" y2="5" />
            <polyline points="6 11 12 5 18 11" />
          </svg>
          {t(copy.backToSearch, lang)}
        </a>
      </div>
    </section>
  ))}

  <!-- Geen volledige site-footer op de tafelkaart (zie showFooter={false}
       hierboven) — enkel deze subtiele, stijlvolle uitnodiging naar de
       hoofdsite, voor gasten die na hun bezoek meer willen weten. -->
  <section class="max-w-3xl mx-auto px-5 sm:px-8 pt-4 pb-14 text-center">
    <div class="carte-site-invite">
      <p class="text-sm" style="color: var(--color-text-muted)">
        {t(copy.visitWebsite, lang)}
      </p>
      <div class="carte-site-invite-links">
        <a href={localizedPath('/', lang)} class="carte-site-invite-link">
          {t(copy.visitWebsiteCta, lang)}
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="rtl:rotate-180">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
        <!-- Google-avis, plek 2: hier onderaan bereikt de gasten die de
             hele kaart doorbladeren zonder (nog) te bestellen — een groep
             die plek 1 (het bestel-bevestigingsscherm) nooit ziet. Zelfde
             visuele gewicht als de website-link ernaast, geen van beide
             domineert. -->
        {siteConfig.social.googleReviewsUrl && (
          <a href={siteConfig.social.googleReviewsUrl} target="_blank" rel="noreferrer" class="carte-site-invite-link">
            {t(copy.reviewFooterCta, lang)}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7L12 2z" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Zwevende mandje-balk: verborgen zolang het mandje leeg is (zie
       data-cart-bar / JS hieronder), verschijnt zodra de gast iets
       toevoegt. Zelfde plek als de WhatsApp-knop elders op de site nam
       (die is hier uitgezet, zie showWhatsApp={false} hierboven) zodat
       er geen twee zwevende knoppen om dezelfde duim-ruimte concurreren. -->
  <button type="button" id="carte-cart-bar" class="carte-cart-bar hidden" data-cart-bar aria-haspopup="dialog">
    <span class="carte-cart-bar-count" data-cart-count>0</span>
    <span class="carte-cart-bar-label">{t(copy.cartBarLabel, lang)}</span>
    <span class="carte-cart-bar-total" data-cart-total>0 MAD</span>
  </button>

  <!-- Mandje + afreken-dialog: zelfde native <dialog>-patroon als de
       gerecht-infoschermen hierboven (focus-trap/Escape gratis mee). -->
  <dialog id="carte-cart-dialog" class="dish-dialog cart-dialog" aria-labelledby="carte-cart-title">
    <div class="dish-dialog-card cart-dialog-card">
      <button type="button" class="dish-dialog-close" data-cart-close aria-label={t(copy.cartClose, lang)}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>

      <!-- Alles-in-1x-wissen: naast de sluitknop, alleen zichtbaar zodra er
           iets in het mandje zit (zelfde data-cart-has-items-mechanisme als
           het tafelnummer-veld/totaalregel hieronder). Vraagt eerst
           bevestiging (native confirm()) — dit wist het hele mandje, dus
           geen per-ongeluk-tik zonder terugvraag. -->
      <button
        type="button"
        class="cart-clear-btn"
        data-cart-clear-all
        data-cart-has-items
        hidden
        aria-label={t(copy.cartClearAll, lang)}
        data-confirm-msg={t(copy.cartClearConfirm, lang)}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6" />
          <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" />
          <path d="M10 11v6M14 11v6M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" />
        </svg>
      </button>

      <div class="dish-dialog-body cart-dialog-body">
        <h2 id="carte-cart-title" class="font-display text-2xl font-semibold" style="color: var(--color-text-primary)">
          {t(copy.cartTitle, lang)}
        </h2>

        <!-- Staat 1: mandje bewerken -->
        <div data-cart-view-items>
          <p class="text-sm mt-4" data-cart-empty-msg style="color: var(--color-text-muted)">
            {t(copy.cartEmpty, lang)}
          </p>
          <div class="cart-items mt-2" data-cart-items></div>

          <div class="cart-total-row" data-cart-has-items hidden>
            <span style="color: var(--color-text-muted)">{t(copy.cartItemTotal, lang)}</span>
            <span class="font-bold" data-cart-dialog-total style="color: var(--color-accent)">0 MAD</span>
          </div>

          <div class="mt-5" data-cart-has-items hidden>
            <label class="block text-xs font-bold uppercase tracking-wide mb-1.5" style="color: var(--color-text-muted)" for="cart-table-number">
              {t(copy.tableNumberLabel, lang)}
            </label>
            <input
              id="cart-table-number"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              placeholder={t(copy.tableNumberPlaceholder, lang)}
              class="cart-input"
              data-cart-table-input
            />
            <p class="cart-field-error" data-cart-table-error hidden>{t(copy.tableNumberRequired, lang)}</p>

            <label class="block text-xs font-bold uppercase tracking-wide mb-1.5 mt-4" style="color: var(--color-text-muted)" for="cart-notes">
              {t(copy.notesLabel, lang)}
            </label>
            <textarea
              id="cart-notes"
              rows="2"
              placeholder={t(copy.notesPlaceholder, lang)}
              class="cart-input"
              data-cart-notes-input
            ></textarea>

            <button
              type="button"
              class="cart-submit-btn mt-5"
              data-cart-submit
              data-submit-label={t(copy.submitOrder, lang)}
              data-sending-label={t(copy.sendingOrder, lang)}
            >
              <span data-cart-submit-label>{t(copy.submitOrder, lang)}</span>
            </button>
            <p class="cart-field-error" data-cart-submit-error hidden>{t(copy.orderErrorBody, lang)}</p>
          </div>
        </div>

        <!-- Staat 2: bevestiging na succesvol versturen -->
        <div data-cart-view-success hidden class="cart-success">
          <span class="cart-success-icon" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 12 9 17 20 6" />
            </svg>
          </span>
          <h3 class="font-display text-xl font-semibold mt-3" style="color: var(--color-text-primary)">
            {t(copy.orderSuccessTitle, lang)}
          </h3>
          <p class="text-sm mt-2" style="color: var(--color-text-muted)">
            {t(copy.orderSuccessBody, lang)}
          </p>

          <!-- Google-avis, plek 1: dit bevestigingsscherm — het moment vlak
               ná een geslaagde actie (bestelling verstuurd), wanneer de
               gast nog positief betrokken is. Bewust een stille tweede
               link, niet de hoofdknop: er is nog niet gegeten, dus dit
               vráágt niet "hoe was het eten", het geeft alleen de optie
               vast klaar te zetten voor wie na afloop terug wil komen. -->
          {siteConfig.social.googleReviewsUrl && (
            <div class="review-nudge mt-5">
              <p class="text-xs" style="color: var(--color-text-muted)">
                {t(copy.reviewSuccessPrompt, lang)}
              </p>
              <a href={siteConfig.social.googleReviewsUrl} target="_blank" rel="noreferrer" class="review-nudge-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17l-6.1 3.5 1.5-6.8L2.2 9l6.9-.7L12 2z" />
                </svg>
                {t(copy.reviewSuccessCta, lang)}
              </a>
            </div>
          )}

          <button type="button" class="cart-submit-btn mt-5" data-cart-success-close>
            {t(copy.orderSuccessClose, lang)}
          </button>
        </div>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  /* ---- Categorie-chips: horizontaal swipebaar, scrollbar verborgen maar
     scroll-snap zodat een chip nooit halverwege blijft hangen na een
     swipe-vinger-vlug. ---- */
  .carte-chip-row {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding-bottom: 2px;
    margin-inline: -1.25rem;
    padding-inline: 1.25rem;
  }
  @media (min-width: 640px) {
    .carte-chip-row {
      margin-inline: -2rem;
      padding-inline: 2rem;
    }
  }
  .carte-chip-row::-webkit-scrollbar {
    display: none;
  }
  .carte-chip {
    scroll-snap-align: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-muted);
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }
  .carte-chip svg {
    color: var(--color-accent);
    opacity: 0.85;
    flex-shrink: 0;
  }
  .carte-chip.is-active {
    color: var(--color-background);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .carte-chip.is-active svg {
    color: var(--color-background);
    opacity: 1;
  }

  /* ---- Elke categorie-sectie springt netjes onder de sticky header +
     zoek/chip-balk uit i.p.v. er half achter verstopt te blijven. ---- */
  .carte-category-section {
    scroll-margin-top: 172px;
  }
  @media (min-width: 640px) {
    .carte-category-section {
      scroll-margin-top: 196px;
    }
  }

  /* ---- Zoekbalk: verbergt niet-matchende rijen/categorieën ---- */
  .is-search-hidden {
    display: none !important;
  }
  .carte-search-input {
    -webkit-appearance: none;
    appearance: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .carte-search-input::-webkit-search-cancel-button {
    display: none;
  }
  .carte-search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }
  .carte-search-input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.75;
  }

  /* ---- Terug-naar-zoeken-link: bewust klein en stijlvol, geen knop die
     met de "i"-knoppen concurreert ---- */
  .back-to-search-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    background-color: color-mix(in srgb, var(--color-accent) 6%, transparent);
    transition: background-color 0.15s ease, transform 0.12s ease;
  }
  .back-to-search-link:hover {
    background-color: color-mix(in srgb, var(--color-accent) 14%, transparent);
  }
  .back-to-search-link:active {
    transform: scale(0.97);
  }

  /* ---- Uitnodiging naar de hoofdsite, onderaan de kaart (vervangt de
     volledige site-footer op deze pagina, zie showFooter={false}) ---- */
  .carte-site-invite {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .carte-site-invite-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: 1.75rem;
    row-gap: 0.4rem;
  }
  .carte-site-invite-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    padding-bottom: 0.15rem;
    transition: border-color 0.15s ease, gap 0.15s ease;
  }
  .carte-site-invite-link:hover {
    gap: 0.6rem;
    border-color: var(--color-accent);
  }

  /* ---- Halal-zegel bovenaan de hero ---- */
  .halal-seal {
    filter: drop-shadow(0 2px 10px color-mix(in srgb, var(--color-accent) 25%, transparent));
  }
  @media (min-width: 640px) {
    .halal-seal {
      width: 96px;
      height: 96px;
    }
  }

  /* ---- Google-avis-uitnodiging in het bestel-bevestigingsscherm ---- */
  .review-nudge {
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
  }
  .review-nudge-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .review-nudge-link:hover {
    text-decoration: underline;
  }

  /* ---- Trigger-rij: kleine tik-feedback ---- */
  .dish-trigger {
    cursor: pointer;
    transition: transform 0.12s ease;
  }
  .dish-trigger:active {
    transform: scale(0.99);
  }

  /* ---- Bestel-stepper onder elke gerecht-kaart ---- */
  .qty-add-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    color: var(--color-background);
    background-color: var(--color-accent);
    border: none;
    transition: transform 0.12s ease, filter 0.15s ease;
  }
  .qty-add-btn:hover {
    filter: brightness(1.08);
  }
  .qty-add-btn:active {
    transform: scale(0.95);
  }
  .qty-full {
    display: none;
  }
  .qty-stepper[data-qty="0"] .qty-full {
    display: none;
  }
  .qty-stepper:not([data-qty="0"]) .qty-full {
    display: flex;
  }
  .qty-stepper:not([data-qty="0"]) .qty-add-btn {
    display: none;
  }
  .qty-value {
    min-width: 1.2rem;
    text-align: center;
  }
  .qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    transition: background-color 0.15s ease, transform 0.12s ease;
  }
  .qty-btn:hover {
    background-color: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }
  .qty-btn:active {
    transform: scale(0.92);
  }

  /* ---- Dialog: native <dialog>, zelf volledig scherm-gevuld gemaakt zodat
