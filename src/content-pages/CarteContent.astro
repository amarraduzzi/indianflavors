  .cart-clear-btn {
    position: absolute;
    top: 14px;
    right: 58px;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(224, 138, 138, 0.12);
