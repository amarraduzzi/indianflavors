---
// Tafelkaart via QR-code — nog steeds géén hero-afbeelding of Ken Burns-effect
// zoals MenuContent.astro (snel laden, snel scannen). Elk gerecht toont een
// compacte rij (foto/placeholder, naam, badge, prijs) met een duidelijk
// "i" info-icoon; een tik erop opent een ECHT fullscreen infoscherm (native
// <dialog>, dus toegankelijk + Escape/backdrop-klik werkt gratis mee) met
// grote foto, het verhaal van het gerecht en de ingrediënten. Dit *is* het
// educatieve stuk van de kaart: de doelgroep kent de Indiase keuken niet, dus
// dit scherm moet overtuigen, niet alleen informeren.
// Toont ALLEEN de restaurantprijs (zie full-menu.ts voor de bron).
//
// v3 (modal-herontwerp, vervangt de v2 inline-accordion): elk gerecht heeft
// nu een eigen <dialog id="dish-...">, geopend via vanilla JS
// (`astro:page-load`, zelfde patroon als Header.astro). Geen client
// framework nodig — <dialog>.showModal() geeft focus-trap, Escape-to-close
// en een ::backdrop gratis; de fade/scale-animatie zelf gaat via een CSS-
// klasse die na showModal() wordt toegevoegd (dialogs animeren niet
// vanzelf bij het openen zonder @starting-style, en dat heeft nog geen
// brede iOS Safari-steun).
//
// Volgt hetzelfde i18n/Layout-patroon als MenuContent.astro zodat dit naast
// de bestaande site past zonder iets anders te breken.

import Layout from '../layouts/Layout.astro';
import Ornament from '../components/Ornament.astro';
import { siteConfig } from '../config/site.config';
import { fullMenu } from '../content/full-menu';
import { t, localizedPath, type Language } from '../i18n/languages';
import { place } from '../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = 'fr' } = Astro.props;
const { name } = siteConfig.identity;
const city = t(place.city, lang);

const copy = {
  metaTitle: {
    fr: `Notre carte — ${name}`,
    en: `Our menu — ${name}`,
    ar: `قائمتنا — ${name}`,
  },
  metaDescription: {
    fr: `La carte complète de ${name} à ${city}, à consulter sur place.`,
    en: `The full menu of ${name} in ${city}, for dine-in guests.`,
    ar: `القائمة الكاملة لـ${name} في ${city}، للضيوف داخل المطعم.`,
  },
  heroTitle: { fr: 'Notre carte', en: 'Our menu', ar: 'قائمتنا' },
  heroSubtitle: {
    fr: 'Prix service à table. Une question sur un plat ? Notre équipe se fera un plaisir de vous conseiller.',
    en: 'Dine-in prices. Questions about a dish? Our team is happy to help.',
    ar: 'أسعار الخدمة داخل المطعم. لديك سؤال عن طبق؟ فريقنا سعيد بمساعدتك.',
  },
  vegLabel: { fr: 'Végétarien', en: 'Vegetarian', ar: 'نباتي' },
  ingredientsLabel: { fr: 'Ingrédients', en: 'Ingredients', ar: 'المكوّنات' },
  infoLabel: { fr: 'Voir le plat', en: 'View dish', ar: 'عرض الطبق' },
  closeLabel: { fr: 'Fermer', en: 'Close', ar: 'إغلاق' },
  searchPlaceholder: {
    fr: 'Rechercher un plat (ex. Biryani, Naan)…',
    en: 'Search a dish (e.g. Biryani, Naan)…',
    ar: 'ابحث عن طبق (مثال: برياني، نان)…',
  },
  searchClear: { fr: 'Effacer la recherche', en: 'Clear search', ar: 'مسح البحث' },
  searchNoResults: {
    fr: 'Aucun plat ne correspond à votre recherche.',
    en: 'No dish matches your search.',
    ar: 'لا يوجد طبق يطابق بحثك.',
  },
  backToSearch: { fr: 'Retour à la recherche', en: 'Back to search', ar: 'العودة إلى البحث' },
  visitWebsite: {
    fr: 'Envie d’en savoir plus sur nous ?',
    en: 'Want to know more about us?',
    ar: 'هل تريد معرفة المزيد عنا؟',
  },
  visitWebsiteCta: { fr: 'Visitez notre site', en: 'Visit our website', ar: 'زوروا موقعنا' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const path = localizedPath('/carte', lang);

// Eén klein lijn-icoon per categorie — puur decoratief (aria-hidden), dus
// geen vertaling nodig. Gekoppeld op het FR-label (de brontaal van de data)
// zodat dit blijft werken ongeacht welke taal er gerenderd wordt. Onbekende
// categorieën vallen terug op het bestek-icoon, dus dit breekt nooit als er
// later een categorie bijkomt.
const categoryIcons: Record<string, string> = {
  Soupes: 'M4 12h16M4 12a8 8 0 0016 0M4 12l1-5h14l1 5M9 4v2M12 3v2.5M15 4v2',
  'Entrées Végétariennes': 'M12 21c-4-2-7-6-7-11a7 7 0 0114 0c0 5-3 9-7 11z',
  'Entrées Non-Végétariennes': 'M8 3c2 1 3 3 3 5l7 7a2.5 2.5 0 01-3.5 3.5L7 11c-2 0-4-1-5-3',
  'Plats Principaux': 'M4 13a8 8 0 0016 0H4z M12 3v2 M8 4l.5 1.5 M16 4l-.5 1.5',
  'Spécialités Tandoori': 'M12 3c-1.5 3-4.5 4.5-4.5 8.5a4.5 4.5 0 009 0C16.5 7.5 13.5 6 12 3z',
  'Plats Principaux Végétariens': 'M12 21c-4-2-7-6-7-11a7 7 0 0114 0c0 5-3 9-7 11z',
  "Biryani Dum d'Hyderabad": 'M5 11h14l-1 8a2 2 0 01-2 2H8a2 2 0 01-2-2l-1-8z M4 11a8 3 0 0016 0',
  'Naan, Riz & Nouilles': 'M4 8c4-3 12-3 16 0-2 2-2 5 0 7-4 3-12 3-16 0 2-2 2-5 0-7z',
  Desserts: 'M12 3l1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8L12 3z M6 18h12',
  'Boissons Fraîches': 'M7 4h10l-1 15a2 2 0 01-2 2h-4a2 2 0 01-2-2L7 4z M6 4h12 M9 9h6',
  'Boissons Chaudes': 'M4 9h13v5a4 4 0 01-4 4H8a4 4 0 01-4-4V9z M17 10h1.5a2 2 0 010 4H17 M8 4c0 1-1 1-1 2 M12 4c0 1-1 1-1 2',
};
const fallbackIconPath = 'M8 3v6a2 2 0 002 2h0a2 2 0 002-2V3 M12 3v18 M16 3c-1.5 0-3 1.5-3 4s1.5 4 3 4v10';

// Stabiele, url-veilige id per gerecht voor de dialog (fr-naam is uniek
// genoeg in deze kaart; géén diakrieten/spaties toegestaan in een id).
function dishId(categoryIndex: number, itemIndex: number, itemName: string): string {
  const slug = itemName
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
  return `dish-${categoryIndex}-${itemIndex}-${slug}`;
}

// Zelfde soort stabiele id, maar dan voor de categorie-secties zelf \u2014 het
// ankerpunt voor de horizontaal swipebare chip-rij hieronder (op het FR-
// label, om dezelfde reden als categoryIcons hierboven).
function categoryId(categoryIndex: number, labelFr: string): string {
  const slug = labelFr
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
  return `cat-${categoryIndex}-${slug}`;
}
---

<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
  minimalHeader
  showFooter={false}
>
  <!-- Compacte, tekstuele hero — geen beeld, laadt razendsnel op mobiel. -->
  <section class="max-w-3xl mx-auto px-5 sm:px-8 pt-10 pb-6 text-center">
    <h1 class="font-display text-3xl sm:text-4xl font-semibold" style="color: var(--color-text-primary)">
      {t(copy.heroTitle, lang)}
    </h1>
    <p class="mt-3 text-sm sm:text-base" style="color: var(--color-text-muted)">
      {t(copy.heroSubtitle, lang)}
    </p>
  </section>

  <!-- Zoekbalk — sticky onder de header, zelfde idee als de "Glovo-stijl"
       bestelsite maar met het donker/goud vocabulaire van déze site
       i.p.v. losse felle kleuren. Puur client-side filteren op naam (geen
       reload, geen server nodig): elke gerecht-knop draagt zijn naam in
       data-dish-name, het script hieronder verbergt niet-matchende rijen
       én hele categorieën die daardoor leeg blijven. Dit is ook het
       "terug naar boven"-ankerpunt voor de linkjes onder elke categorie. -->
  <div
    id="carte-search-bar"
    class="sticky top-16 sm:top-20 z-30"
    style="background-color: color-mix(in srgb, var(--color-surface) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--color-border)"
  >
    <div class="max-w-3xl mx-auto px-5 sm:px-8 py-3">
      <div class="relative">
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="absolute top-1/2 -translate-y-1/2 pointer-events-none rtl:right-4 ltr:left-4"
          style="color: var(--color-accent)"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          id="carte-search-input"
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder={t(copy.searchPlaceholder, lang)}
          class="carte-search-input w-full rounded-full text-sm rtl:pr-11 rtl:pl-4 ltr:pl-11 ltr:pr-4 py-3"
          style="background-color: var(--color-surface-muted); border: 1px solid var(--color-border); color: var(--color-text-primary)"
        />
        <button
          type="button"
          id="carte-search-clear"
          class="hidden absolute top-1/2 -translate-y-1/2 items-center justify-center w-6 h-6 rounded-full rtl:left-3 ltr:right-3"
          style="background-color: var(--color-border); color: var(--color-text-primary)"
          aria-label={t(copy.searchClear, lang)}
        >
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
            <line x1="5" y1="5" x2="19" y2="19" />
            <line x1="19" y1="5" x2="5" y2="19" />
          </svg>
        </button>
      </div>

      <!-- Categorie-chips: horizontaal swipebaar (native overflow-scroll,
           dus vinger-swipe werkt zonder JS), zelfde idee als de
           bestelsite's categorie-pillen maar in het donker/goud vocabulaire
           van déze site. Springt naar de sectie (native anchor-scroll,
           scroll-margin-top op elke sectie compenseert voor deze sticky
           balk) en licht de categorie op waar de gast net aan het scrollen
           is via IntersectionObserver in het script hieronder. -->
      <div class="carte-chip-row mt-3" role="tablist" aria-label={t(copy.heroTitle, lang)}>
        {fullMenu.map((category, ci) => {
          const cid = categoryId(ci, category.label.fr);
          return (
            <a
              href={`#${cid}`}
              class="carte-chip"
              data-chip-target={cid}
              role="tab"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={categoryIcons[category.label.fr] ?? fallbackIconPath} />
              </svg>
              <span>{t(category.label, lang)}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Leeg-resultaat melding — verborgen totdat het script hem toont. -->
  <p id="carte-search-empty" class="hidden max-w-3xl mx-auto px-5 sm:px-8 py-8 text-center text-sm" style="color: var(--color-text-muted)">
    {t(copy.searchNoResults, lang)}
  </p>

  {fullMenu.map((category, ci) => (
    <section
      id={categoryId(ci, category.label.fr)}
      class="carte-category-section max-w-3xl mx-auto px-5 sm:px-8 py-6"
      data-carte-category
    >
      <h2
        class="font-display text-xl font-semibold mb-1 flex items-center gap-3"
        style="color: var(--color-text-primary)"
      >
        <span
          class="flex items-center justify-center w-9 h-9 rounded-full shrink-0"
          style="background-color: color-mix(in srgb, var(--color-accent) 14%, transparent)"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent)" aria-hidden="true">
            <path d={categoryIcons[category.label.fr] ?? fallbackIconPath} />
          </svg>
        </span>
        {t(category.label, lang)}
      </h2>
      <Ornament />
      <div class="flex flex-col gap-3 mt-2">
        {category.items.map((item, ii) => {
          const id = dishId(ci, ii, item.name);
          return (
            <>
              <!-- Rij: het hele blok is de trigger die de dialog opent. -->
              <button
                type="button"
                class="dish-trigger group flex items-center justify-between gap-4 rounded-2xl px-4 py-3 text-left w-full"
                style={`background-color: var(--color-surface); border: 1px solid var(--color-border); box-shadow: 0 1px 0 rgba(255,255,255,0.04) inset, 0 10px 24px -16px rgba(0,0,0,0.6)${item.image ? ', 0 0 0 1px color-mix(in srgb, var(--color-accent) 8%, transparent)' : ''}`}
                data-dialog-target={id}
                data-dish-name={item.name}
                aria-haspopup="dialog"
              >
                <span class="flex items-center gap-3.5 min-w-0">
                  {item.image ? (
                    <!-- Dunne goud-gradient "lijst" om de foto: het accent draagt
                         nu ook de fotografie, niet alleen tekst en badges. -->
                    <span
                      class="rounded-xl p-[2px] shrink-0"
                      style="background: linear-gradient(135deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 25%, transparent))"
                    >
                      <img
                        src={item.image}
                        alt=""
                        loading="lazy"
                        class="w-20 h-20 sm:w-24 sm:h-24 rounded-[10px] object-cover block"
                      />
                    </span>
                  ) : (
                    <span
                      class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl shrink-0 flex items-center justify-center"
                      style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 22%, transparent), color-mix(in srgb, var(--color-primary-dark) 35%, var(--color-surface)))"
                      aria-hidden="true"
                    >
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent)">
                        <path d={fallbackIconPath} />
                      </svg>
                    </span>
                  )}
                  <span class="min-w-0">
                    <span class="block font-semibold" style="color: var(--color-text-primary)">
                      {item.name}
                      {item.vegetarian && <span class="text-xs align-middle ml-1" title={t(copy.vegLabel, lang)}>🌱</span>}
                    </span>
                    {item.tags && item.tags.length > 0 && (
                      <span class="flex flex-wrap gap-1 mt-1">
                        {item.tags.map((tag) => (
                          <span
                            class="text-[10px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded-full"
                            style="color: var(--color-background); background-color: var(--color-accent)"
                          >
                            {t(tag, lang)}
                          </span>
                        ))}
                      </span>
                    )}
                  </span>
                </span>
                <!-- Prijs + info samen in één goud-getinte pil i.p.v. losse
                     elementen: het accent krijgt hier een duidelijker "vorm"
                     in plaats van alleen gekleurde tekst. -->
                <span
                  class="flex items-center gap-2 pl-3 pr-1 py-1 rounded-full shrink-0"
                  style="background-color: color-mix(in srgb, var(--color-accent) 10%, transparent); border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent)"
                >
                  <span class="font-bold text-sm whitespace-nowrap" style="color: var(--color-accent)">{item.priceMAD} MAD</span>
                  <!-- Info-icoon: de expliciete uitnodiging om het gerecht te openen. -->
                  <span
                    class="flex items-center justify-center w-7 h-7 rounded-full transition-transform duration-150 group-active:scale-90 shrink-0"
                    style="background-color: var(--color-accent); color: var(--color-background)"
                    aria-hidden="true"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                      <circle cx="12" cy="12" r="10" stroke-width="1.6" />
                      <line x1="12" y1="11" x2="12" y2="16.5" />
                      <circle cx="12" cy="7.7" r="1.1" fill="currentColor" stroke="none" />
                    </svg>
                  </span>
                </span>
                <span class="sr-only">{t(copy.infoLabel, lang)}</span>
              </button>

              <!-- Fullscreen infoscherm voor dit gerecht. -->
              <dialog id={id} class="dish-dialog" aria-labelledby={`${id}-title`}>
                <div class="dish-dialog-card">
                  <div class="dish-dialog-hero">
                    {item.image ? (
                      <img src={item.image} alt={item.name} class="dish-dialog-hero-img" />
                    ) : (
                      <div
                        class="dish-dialog-hero-img flex items-center justify-center"
                        style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 24%, transparent), color-mix(in srgb, var(--color-primary-dark) 40%, var(--color-surface)))"
                        aria-hidden="true"
                      >
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent); opacity: 0.75">
                          <path d={fallbackIconPath} />
                        </svg>
                      </div>
                    )}
                    <div class="dish-dialog-hero-fade" aria-hidden="true"></div>
                    <button type="button" class="dish-dialog-close" data-dialog-close aria-label={t(copy.closeLabel, lang)}>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                        <line x1="5" y1="5" x2="19" y2="19" />
                        <line x1="19" y1="5" x2="5" y2="19" />
                      </svg>
                    </button>
                    <div class="dish-dialog-hero-caption">
                      {item.tags && item.tags.length > 0 && (
                        <span class="flex flex-wrap gap-1 mb-2">
                          {item.tags.map((tag) => (
                            <span
                              class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full"
                              style="color: var(--color-background); background-color: var(--color-accent)"
                            >
                              {t(tag, lang)}
                            </span>
                          ))}
                        </span>
                      )}
                      <h3 id={`${id}-title`} class="font-display text-2xl sm:text-3xl font-semibold" style="color: #fff">
                        {item.name}
                        {item.vegetarian && <span class="text-base align-middle ml-1" title={t(copy.vegLabel, lang)}>🌱</span>}
                      </h3>
                      <span
                        class="inline-block mt-1 font-bold text-sm px-3 py-1 rounded-full"
                        style="color: var(--color-accent); background-color: rgba(0,0,0,0.35); border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent)"
                      >
                        {item.priceMAD} MAD
                      </span>
                    </div>
                  </div>
                  <div class="dish-dialog-body">
                    <p class="text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">
                      {t(item.story ?? item.description, lang)}
                    </p>
                    {item.ingredients && (
                      <div class="mt-4 pt-4" style="border-top: 1px solid var(--color-border)">
                        <span class="text-xs font-bold uppercase tracking-wide" style="color: var(--color-accent)">
                          {t(copy.ingredientsLabel, lang)}
                        </span>
                        <p class="text-sm mt-1.5" style="color: var(--color-text-muted)">
                          {t(item.ingredients, lang)}
                        </p>
                      </div>
                    )}
                  </div>
                </div>
              </dialog>
            </>
          );
        })}
      </div>
      <!-- Terug-naar-zoeken: elke categorie eindigt met dezelfde stijlvolle
           uitnodiging om weer boven aan de zoekbalk te beginnen, i.p.v. dat
           de gast helemaal terug moet scrollen. -->
      <div class="flex justify-center mt-5">
        <a href="#top" class="back-to-search-link" data-back-to-search>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="19" x2="12" y2="5" />
            <polyline points="6 11 12 5 18 11" />
          </svg>
          {t(copy.backToSearch, lang)}
        </a>
      </div>
    </section>
  ))}

  <!-- Geen volledige site-footer op de tafelkaart (zie showFooter={false}
       hierboven) — enkel deze subtiele, stijlvolle uitnodiging naar de
       hoofdsite, voor gasten die na hun bezoek meer willen weten. -->
  <section class="max-w-3xl mx-auto px-5 sm:px-8 pt-4 pb-14 text-center">
    <div class="carte-site-invite">
      <p class="text-sm" style="color: var(--color-text-muted)">
        {t(copy.visitWebsite, lang)}
      </p>
      <a href={localizedPath('/', lang)} class="carte-site-invite-link">
        {t(copy.visitWebsiteCta, lang)}
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="rtl:rotate-180">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* ---- Categorie-chips: horizontaal swipebaar, scrollbar verborgen maar
     scroll-snap zodat een chip nooit halverwege blijft hangen na een
     swipe-vinger-vlug. ---- */
  .carte-chip-row {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding-bottom: 2px;
    margin-inline: -1.25rem;
    padding-inline: 1.25rem;
  }
  @media (min-width: 640px) {
    .carte-chip-row {
      margin-inline: -2rem;
      padding-inline: 2rem;
    }
  }
  .carte-chip-row::-webkit-scrollbar {
    display: none;
  }
  .carte-chip {
    scroll-snap-align: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-muted);
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }
  .carte-chip svg {
    color: var(--color-accent);
    opacity: 0.85;
    flex-shrink: 0;
  }
  .carte-chip.is-active {
    color: var(--color-background);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .carte-chip.is-active svg {
    color: var(--color-background);
    opacity: 1;
  }

  /* ---- Elke categorie-sectie springt netjes onder de sticky header +
     zoek/chip-balk uit i.p.v. er half achter verstopt te blijven. ---- */
  .carte-category-section {
    scroll-margin-top: 172px;
  }
  @media (min-width: 640px) {
    .carte-category-section {
      scroll-margin-top: 196px;
    }
  }

  /* ---- Zoekbalk: verbergt niet-matchende rijen/categorieën ---- */
  .is-search-hidden {
    display: none !important;
  }
  .carte-search-input {
    -webkit-appearance: none;
    appearance: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .carte-search-input::-webkit-search-cancel-button {
    display: none;
  }
  .carte-search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }
  .carte-search-input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.75;
  }

  /* ---- Terug-naar-zoeken-link: bewust klein en stijlvol, geen knop die
     met de "i"-knoppen concurreert ---- */
  .back-to-search-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    background-color: color-mix(in srgb, var(--color-accent) 6%, transparent);
    transition: background-color 0.15s ease, transform 0.12s ease;
  }
  .back-to-search-link:hover {
    background-color: color-mix(in srgb, var(--color-accent) 14%, transparent);
  }
  .back-to-search-link:active {
    transform: scale(0.97);
  }

  /* ---- Uitnodiging naar de hoofdsite, onderaan de kaart (vervangt de
     volledige site-footer op deze pagina, zie showFooter={false}) ---- */
  .carte-site-invite {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .carte-site-invite-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    padding-bottom: 0.15rem;
    transition: border-color 0.15s ease, gap 0.15s ease;
  }
  .carte-site-invite-link:hover {
    gap: 0.6rem;
    border-color: var(--color-accent);
  }

  /* ---- Trigger-rij: kleine tik-feedback ---- */
  .dish-trigger {
    cursor: pointer;
    transition: transform 0.12s ease;
  }
  .dish-trigger:active {
    transform: scale(0.99);
  }

  /* ---- Dialog: native <dialog>, zelf volledig scherm-gevuld gemaakt zodat
     een klik "ernaast" (op het dialog-element zelf, niet op de kaart erin)
     als backdrop-klik gedetecteerd kan worden. De ::backdrop geeft de
     donkere, vervaagde achtergrond. ---- */
  .dish-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    display: none;
    align-items: flex-end;
    justify-content: center;
  }
  .dish-dialog[open] {
    display: flex;
  }
  @media (min-width: 640px) {
    .dish-dialog[open] {
      align-items: center;
      padding: 24px;
    }
  }
  .dish-dialog::backdrop {
    background: rgba(6, 6, 8, 0.72);
    backdrop-filter: blur(6px);
  }

  .dish-dialog-card {
    width: 100%;
    max-width: 100%;
    max-height: 92vh;
    overflow-y: auto;
    background-color: var(--color-background);
    border-radius: 24px 24px 0 0;
    border-top: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    box-shadow: 0 -12px 40px rgba(0,0,0,0.5), 0 -1px 0 color-mix(in srgb, var(--color-accent) 20%, transparent);
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.26s ease, transform 0.26s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (min-width: 640px) {
    .dish-dialog-card {
      max-width: 560px;
      border-radius: 24px;
      transform: translateY(12px) scale(0.97);
    }
  }
  .dish-dialog.is-visible .dish-dialog-card {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .dish-dialog-hero {
    position: relative;
    height: 260px;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .dish-dialog-hero {
      height: 300px;
      border-radius: 24px 24px 0 0;
    }
  }
  .dish-dialog-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dish-dialog-hero-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.15) 55%, rgba(0,0,0,0.05) 100%);
  }
  .dish-dialog-hero-caption {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 16px;
  }
  .dish-dialog-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(11,11,12,0.55);
    backdrop-filter: blur(4px);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.18);
  }
  .dish-dialog-body {
    padding: 20px;
  }
  @media (min-width: 640px) {
    .dish-dialog-body {
      padding: 24px;
    }
  }
</style>

<script>
  // Vanilla JS voor de gerecht-dialogs. Zelfde `astro:page-load`-patroon als
  // Header.astro (fire bij eerste load EN na client-side navigatie).
  // Rebind-guard (`data-bound`) omdat de DOM-nodes na een navigatie
  // vervangen zijn maar het event soms dubbel afgaat.
  function setupDishDialogs() {
    const triggers = document.querySelectorAll<HTMLButtonElement>('.dish-trigger[data-dialog-target]');

    function openDialog(dialog: HTMLDialogElement) {
      dialog.showModal();
      // Twee frames wachten zodat de browser de 'display:flex' + startstaat
      // eerst laat renderen, vóórdat de overgangs-klasse erbij komt —
      // anders slaat de CSS-transition over (geen echte 'van-naar' meer).
      requestAnimationFrame(() => {
        requestAnimationFrame(() => dialog.classList.add('is-visible'));
      });
    }

    function closeDialog(dialog: HTMLDialogElement) {
      dialog.classList.remove('is-visible');
      const onEnd = () => {
        dialog.close();
        dialog.removeEventListener('transitionend', onEnd);
      };
      dialog.addEventListener('transitionend', onEnd);
      // Vangnet: als er om wat voor reden geen transitionend komt (bv. card
      // had geen overgang omdat 'm nooit zichtbaar werd), toch sluiten.
      setTimeout(() => {
        if (dialog.open) dialog.close();
      }, 400);
    }

    triggers.forEach((trigger) => {
      if (trigger.dataset.bound === 'true') return;
      trigger.dataset.bound = 'true';
      const targetId = trigger.dataset.dialogTarget;
      const dialog = targetId ? document.getElementById(targetId) : null;
      if (!(dialog instanceof HTMLDialogElement)) return;

      trigger.addEventListener('click', () => openDialog(dialog));

      dialog.querySelectorAll('[data-dialog-close]').forEach((btn) => {
        btn.addEventListener('click', () => closeDialog(dialog));
      });

      // Klik op de dialog zelf (dus buiten de kaart) = backdrop-klik.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) closeDialog(dialog);
      });

      // Esc sluit de <dialog> al standaard, maar dan zonder onze
      // uitloop-animatie — dus die onderscheppen we ook.
      dialog.addEventListener('cancel', (e) => {
        e.preventDefault();
        closeDialog(dialog);
      });
    });
  }

  document.addEventListener('astro:page-load', setupDishDialogs);

  // ---- Zoekbalk: puur client-side filteren op gerecht-naam, geaccent-
  // ongevoelig ("naan" vindt ook "Naân") en zonder reload. Verbergt zowel
  // niet-matchende rijen als hele categorieën die daardoor leeg blijven,
  // en toont een korte "geen resultaten"-melding i.p.v. een lege pagina.
  function setupCarteSearch() {
    const input = document.querySelector<HTMLInputElement>('#carte-search-input');
    const clearBtn = document.querySelector<HTMLButtonElement>('#carte-search-clear');
    const emptyMessage = document.querySelector<HTMLElement>('#carte-search-empty');
    if (!input || input.dataset.bound === 'true') return;
    input.dataset.bound = 'true';

    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.dish-trigger[data-dish-name]'));
    const categories = Array.from(document.querySelectorAll<HTMLElement>('[data-carte-category]'));

    function normalize(s: string): string {
      return s
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '');
    }

    function applySearch(rawQuery: string) {
      const query = normalize(rawQuery.trim());
      clearBtn?.classList.toggle('hidden', query.length === 0);
      clearBtn?.classList.toggle('flex', query.length > 0);

      if (query.length === 0) {
        triggers.forEach((el) => el.classList.remove('is-search-hidden'));
        categories.forEach((el) => el.classList.remove('is-search-hidden'));
        emptyMessage?.classList.add('hidden');
        return;
      }

      triggers.forEach((el) => {
        const name = normalize(el.dataset.dishName ?? '');
        el.classList.toggle('is-search-hidden', !name.includes(query));
      });

      let anyVisible = false;
      categories.forEach((cat) => {
        const hasMatch = Array.from(cat.querySelectorAll<HTMLElement>('.dish-trigger[data-dish-name]')).some(
          (el) => !el.classList.contains('is-search-hidden')
        );
        cat.classList.toggle('is-search-hidden', !hasMatch);
        if (hasMatch) anyVisible = true;
      });

      emptyMessage?.classList.toggle('hidden', anyVisible);
    }

    input.addEventListener('input', () => applySearch(input.value));
    clearBtn?.addEventListener('click', () => {
      input.value = '';
      applySearch('');
      input.focus();
    });

    // "Terug naar zoeken"-links: helemaal naar de bovenkant van de pagina,
    // niet alleen "naar het element scrollen" — de zoekbalk is sticky en
    // staat dus vaak al ergens in beeld, waardoor scrollIntoView() dan
    // niets zichtbaars meer doet. window.scrollTo(0,0) werkt altijd, ook
    // als de balk al zichtbaar was.
    document.querySelectorAll<HTMLAnchorElement>('[data-back-to-search]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
        window.setTimeout(() => input.focus({ preventScroll: true }), 450);
      });
    });
  }

  // ---- Categorie-chips: lichten op afhankelijk van welke sectie net in
  // beeld scrolt (IntersectionObserver, geen scroll-event-gepolder nodig),
  // en houden zichzelf mee-gescrold in hun eigen rij zodat de actieve chip
  // nooit buiten beeld staat. Een tik op een chip zet 'm meteen actief
  // (i.p.v. te wachten tot de observer het bevestigt) — de sprong zelf
  // gaat gratis via de native `href="#..."` + de globale smooth-scroll.
  function setupCarteChips() {
    const chipRow = document.querySelector<HTMLElement>('.carte-chip-row');
    const chips = Array.from(document.querySelectorAll<HTMLAnchorElement>('.carte-chip[data-chip-target]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.carte-category-section[id]'));
    if (!chipRow || chips.length === 0 || chipRow.dataset.bound === 'true') return;
    chipRow.dataset.bound = 'true';

    function setActive(id: string) {
      chips.forEach((chip) => chip.classList.toggle('is-active', chip.dataset.chipTarget === id));
      const activeChip = chips.find((chip) => chip.dataset.chipTarget === id);
      activeChip?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        if (chip.dataset.chipTarget) setActive(chip.dataset.chipTarget);
      });
    });

    if (sections.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]?.target.id) setActive(visible[0].target.id);
        },
        // Smalle band net onder de sticky header/zoekbalk: een sectie telt
        // pas als "actief" zodra 'm daar echt voorbij scrolt.
        { rootMargin: '-180px 0px -70% 0px', threshold: 0 }
      );
      sections.forEach((section) => observer.observe(section));
    } else if (sections[0]?.id) {
      setActive(sections[0].id);
    }
  }

  document.addEventListener('astro:page-load', setupCarteSearch);
  document.addEventListener('astro:page-load', setupCarteChips);
</script>
