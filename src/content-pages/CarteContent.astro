<script>
  // Vanilla JS voor de gerecht-dialogs. Zelfde `astro:page-load`-patroon als
  // Header.astro (fire bij eerste load EN na client-side navigatie).
  // Rebind-guard (`data-bound`) omdat de DOM-nodes na een navigatie
  // vervangen zijn maar het event soms dubbel afgaat.
  function setupDishDialogs() {
    const triggers = document.querySelectorAll<HTMLButtonElement>('.dish-trigger[data-dialog-target]');

    function openDialog(dialog: HTMLDialogElement) {
      dialog.showModal();
      // Twee frames wachten zodat de browser de 'display:flex' + startstaat
      // eerst laat renderen, vóórdat de overgangs-klasse erbij komt —
      // anders slaat de CSS-transition over (geen echte 'van-naar' meer).
      requestAnimationFrame(() => {
        requestAnimationFrame(() => dialog.classList.add('is-visible'));
      });
    }

    function closeDialog(dialog: HTMLDialogElement) {
      dialog.classList.remove('is-visible');
      const onEnd = () => {
        dialog.close();
        dialog.removeEventListener('transitionend', onEnd);
      };
      dialog.addEventListener('transitionend', onEnd);
      // Vangnet: als er om wat voor reden geen transitionend komt (bv. card
      // had geen overgang omdat 'm nooit zichtbaar werd), toch sluiten.
      setTimeout(() => {
        if (dialog.open) dialog.close();
      }, 400);
    }

    triggers.forEach((trigger) => {
      if (trigger.dataset.bound === 'true') return;
      trigger.dataset.bound = 'true';
      const targetId = trigger.dataset.dialogTarget;
      const dialog = targetId ? document.getElementById(targetId) : null;
      if (!(dialog instanceof HTMLDialogElement)) return;

      trigger.addEventListener('click', () => openDialog(dialog));

      dialog.querySelectorAll('[data-dialog-close]').forEach((btn) => {
        btn.addEventListener('click', () => closeDialog(dialog));
      });

      // Klik op de dialog zelf (dus buiten de kaart) = backdrop-klik.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) closeDialog(dialog);
      });

      // Esc sluit de <dialog> al standaard, maar dan zonder onze
      // uitloop-animatie — dus die onderscheppen we ook.
      dialog.addEventListener('cancel', (e) => {
        e.preventDefault();
        closeDialog(dialog);
      });
    });
  }

  document.addEventListener('astro:page-load', setupDishDialogs);

  // ---- Zoekbalk: puur client-side filteren op gerecht-naam, geaccent-
  // ongevoelig ("naan" vindt ook "Naân") en zonder reload. Verbergt zowel
  // niet-matchende rijen als hele categorieën die daardoor leeg blijven,
  // en toont een korte "geen resultaten"-melding i.p.v. een lege pagina.
  function setupCarteSearch() {
    const input = document.querySelector<HTMLInputElement>('#carte-search-input');
    const clearBtn = document.querySelector<HTMLButtonElement>('#carte-search-clear');
    const emptyMessage = document.querySelector<HTMLElement>('#carte-search-empty');
    if (!input || input.dataset.bound === 'true') return;
    input.dataset.bound = 'true';

    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.dish-trigger[data-dish-name]'));
    const categories = Array.from(document.querySelectorAll<HTMLElement>('[data-carte-category]'));

    function normalize(s: string): string {
      return s
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '');
    }

    function applySearch(rawQuery: string) {
      const query = normalize(rawQuery.trim());
      clearBtn?.classList.toggle('hidden', query.length === 0);
      clearBtn?.classList.toggle('flex', query.length > 0);

      if (query.length === 0) {
        triggers.forEach((el) => (el.closest<HTMLElement>('.dish-card') ?? el).classList.remove('is-search-hidden'));
        categories.forEach((el) => el.classList.remove('is-search-hidden'));
        emptyMessage?.classList.add('hidden');
        return;
      }

      triggers.forEach((el) => {
        const name = normalize(el.dataset.dishName ?? '');
        // Verberg de hele kaart (foto+naam+prijs ÉN de bestel-stepper
        // eronder), niet alleen de trigger-knop — anders blijft er bij een
        // niet-matchend gerecht een lege omkaderde strook met een losse
        // stepper staan (zie .dish-card in de markup hierboven, sinds de
        // bestel-stepper naast i.p.v. in de trigger-button zit).
        const card = el.closest<HTMLElement>('.dish-card') ?? el;
        card.classList.toggle('is-search-hidden', !name.includes(query));
      });

      let anyVisible = false;
      categories.forEach((cat) => {
        const hasMatch = Array.from(cat.querySelectorAll<HTMLElement>('.dish-trigger[data-dish-name]')).some(
          (el) => !(el.closest<HTMLElement>('.dish-card') ?? el).classList.contains('is-search-hidden')
        );
        cat.classList.toggle('is-search-hidden', !hasMatch);
        if (hasMatch) anyVisible = true;
      });

      emptyMessage?.classList.toggle('hidden', anyVisible);
    }

    input.addEventListener('input', () => applySearch(input.value));
    clearBtn?.addEventListener('click', () => {
      input.value = '';
      applySearch('');
      input.focus();
    });

    // "Terug naar zoeken"-links: helemaal naar de bovenkant van de pagina,
    // niet alleen "naar het element scrollen" — de zoekbalk is sticky en
    // staat dus vaak al ergens in beeld, waardoor scrollIntoView() dan
    // niets zichtbaars meer doet. window.scrollTo(0,0) werkt altijd, ook
    // als de balk al zichtbaar was.
    document.querySelectorAll<HTMLAnchorElement>('[data-back-to-search]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
        window.setTimeout(() => input.focus({ preventScroll: true }), 450);
      });
    });
  }

  // ---- Categorie-chips: lichten op afhankelijk van welke sectie net in
  // beeld scrolt (IntersectionObserver, geen scroll-event-gepolder nodig),
  // en houden zichzelf mee-gescrold in hun eigen rij zodat de actieve chip
  // nooit buiten beeld staat. Een tik op een chip zet 'm meteen actief
  // (i.p.v. te wachten tot de observer het bevestigt) — de sprong zelf
  // gaat gratis via de native `href="#..."` + de globale smooth-scroll.
  function setupCarteChips() {
    const chipRow = document.querySelector<HTMLElement>('.carte-chip-row');
    const chips = Array.from(document.querySelectorAll<HTMLAnchorElement>('.carte-chip[data-chip-target]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.carte-category-section[id]'));
    if (!chipRow || chips.length === 0 || chipRow.dataset.bound === 'true') return;
    chipRow.dataset.bound = 'true';

    function setActive(id: string) {
      chips.forEach((chip) => chip.classList.toggle('is-active', chip.dataset.chipTarget === id));
      const activeChip = chips.find((chip) => chip.dataset.chipTarget === id);
      activeChip?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        if (chip.dataset.chipTarget) setActive(chip.dataset.chipTarget);
      });
    });

    if (sections.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]?.target.id) setActive(visible[0].target.id);
        },
        // Smalle band net onder de sticky header/zoekbalk: een sectie telt
        // pas als "actief" zodra 'm daar echt voorbij scrolt.
        { rootMargin: '-180px 0px -70% 0px', threshold: 0 }
      );
      sections.forEach((section) => observer.observe(section));
    } else if (sections[0]?.id) {
      setActive(sections[0].id);
    }
  }

  document.addEventListener('astro:page-load', setupCarteSearch);
  document.addEventListener('astro:page-load', setupCarteChips);

  // ---- Bestellen aan tafel: mandje + versturen naar het personeelsscherm.
  // Zelfde Supabase-project + `orders`-tabel + publieke insert-only
  // "publishable key" als de order-site (indianflavor.pages.dev) al
  // gebruikt voor precies hetzelfde doel — dus geen nieuwe backend nodig.
  // Het personeelsscherm (indianflavors-personeelsscherm) heeft al een
  // live Realtime-abonnement op die tabel, dus een insert hiervandaan
  // verschijnt daar vanzelf, net als een bestelling via de order-site nu
  // al doet. Anders dan de order-site (waar dit "fire-and-forget" is naast
  // de WhatsApp-boodschap als bron van waarheid) is dit HIER de enige weg
  // die de bestelling aflegt — dus wél op de respons wachten en een echte
  // fout tonen i.p.v.'m stil te negeren.
  const CARTE_ORDER_SUPABASE_URL = 'https://zzdiibzoalmymgbztepf.supabase.co';
  const CARTE_ORDER_SUPABASE_ANON_KEY = 'sb_publishable_96be9YWDCuHOD9-rmGVkeg_5RTW8Jx7';

  interface CartLine {
    name: string;
    unitPrice: number;
    qty: number;
  }

  function setupCarteCart() {
    const cartBar = document.querySelector<HTMLButtonElement>('[data-cart-bar]');
    const cartDialog = document.querySelector<HTMLDialogElement>('#carte-cart-dialog');
    if (!cartBar || !(cartDialog instanceof HTMLDialogElement) || cartBar.dataset.bound === 'true') return;
    cartBar.dataset.bound = 'true';

    const cart = new Map<string, CartLine>();

    const countEl = cartBar.querySelector<HTMLElement>('[data-cart-count]');
    const totalEl = cartBar.querySelector<HTMLElement>('[data-cart-total]');
    const dialogTotalEl = cartDialog.querySelector<HTMLElement>('[data-cart-dialog-total]');
    const itemsEl = cartDialog.querySelector<HTMLElement>('[data-cart-items]');
    const emptyMsgEl = cartDialog.querySelector<HTMLElement>('[data-cart-empty-msg]');
    const hasItemsEls = cartDialog.querySelectorAll<HTMLElement>('[data-cart-has-items]');
    const tableInput = cartDialog.querySelector<HTMLInputElement>('[data-cart-table-input]');
    const notesInput = cartDialog.querySelector<HTMLTextAreaElement>('[data-cart-notes-input]');
    const tableError = cartDialog.querySelector<HTMLElement>('[data-cart-table-error]');
    const submitBtn = cartDialog.querySelector<HTMLButtonElement>('[data-cart-submit]');
    const submitLabel = cartDialog.querySelector<HTMLElement>('[data-cart-submit-label]');
    const submitError = cartDialog.querySelector<HTMLElement>('[data-cart-submit-error]');
    const viewItems = cartDialog.querySelector<HTMLElement>('[data-cart-view-items]');
    const viewSuccess = cartDialog.querySelector<HTMLElement>('[data-cart-view-success]');

    function cartTotal(): number {
      let sum = 0;
      cart.forEach((line) => (sum += line.unitPrice * line.qty));
      return sum;
    }
    function cartCount(): number {
      let sum = 0;
      cart.forEach((line) => (sum += line.qty));
      return sum;
    }

    function renderBar() {
      const count = cartCount();
      if (countEl) countEl.textContent = String(count);
      if (totalEl) totalEl.textContent = `${cartTotal()} MAD`;
      cartBar.classList.toggle('hidden', count === 0);
    }

    function renderStepperFor(name: string) {
      document.querySelectorAll<HTMLElement>('[data-qty-stepper]').forEach((stepper) => {
        if (stepper.dataset.itemName !== name) return;
        const qty = cart.get(name)?.qty ?? 0;
        stepper.dataset.qty = String(qty);
        const valueEl = stepper.querySelector<HTMLElement>('[data-qty-value]');
        if (valueEl) valueEl.textContent = String(qty);
      });
    }

    function escapeHtml(s: string): string {
      const div = document.createElement('div');
      div.textContent = s;
      return div.innerHTML;
    }

    function renderCartItems() {
      if (!itemsEl) return;
      const lines = Array.from(cart.values());
      if (emptyMsgEl) emptyMsgEl.classList.toggle('hidden', lines.length > 0);
      hasItemsEls.forEach((el) => {
        el.hidden = lines.length === 0;
      });
      itemsEl.innerHTML = '';
      lines.forEach((line) => {
        const row = document.createElement('div');
        row.className = 'cart-item-row';
        row.innerHTML = `
          <div class="cart-item-info">
            <span class="cart-item-name">${escapeHtml(line.name)}</span>
            <span class="cart-item-line">${line.unitPrice} MAD × ${line.qty}</span>
          </div>
          <div class="cart-item-actions">
            <button type="button" class="qty-btn" data-line-minus>−</button>
            <span class="qty-value font-bold text-sm" style="color: var(--color-text-primary)">${line.qty}</span>
            <button type="button" class="qty-btn" data-line-plus>+</button>
          </div>
        `;
        row.querySelector('[data-line-minus]')?.addEventListener('click', () => changeQty(line.name, -1));
        row.querySelector('[data-line-plus]')?.addEventListener('click', () => changeQty(line.name, 1));
        itemsEl.appendChild(row);
      });
      if (dialogTotalEl) dialogTotalEl.textContent = `${cartTotal()} MAD`;
    }

    function changeQty(name: string, delta: number, unitPrice?: number) {
      const existing = cart.get(name);
      const nextQty = Math.max(0, (existing?.qty ?? 0) + delta);
      if (nextQty === 0) {
        cart.delete(name);
      } else {
        cart.set(name, { name, unitPrice: existing?.unitPrice ?? unitPrice ?? 0, qty: nextQty });
      }
      renderBar();
      renderStepperFor(name);
      renderCartItems();
    }

    // Steppers onder elke gerecht-kaart.
    document.querySelectorAll<HTMLElement>('[data-qty-stepper]').forEach((stepper) => {
      if (stepper.dataset.bound === 'true') return;
      stepper.dataset.bound = 'true';
      const name = stepper.dataset.itemName ?? '';
      const price = Number(stepper.dataset.itemPrice ?? '0');
      stepper.querySelector('[data-qty-add]')?.addEventListener('click', () => changeQty(name, 1, price));
      stepper.querySelector('[data-qty-plus]')?.addEventListener('click', () => changeQty(name, 1, price));
      stepper.querySelector('[data-qty-minus]')?.addEventListener('click', () => changeQty(name, -1, price));
    });

    // Dialog open/close — zelfde animatiepatroon als de gerecht-infoschermen
    // (zie setupDishDialogs hierboven), hier los gehouden om die functie
    // niet afhankelijk te maken van het mandje.
    function openCartDialog() {
      cartDialog.showModal();
      requestAnimationFrame(() => requestAnimationFrame(() => cartDialog.classList.add('is-visible')));
    }
    function closeCartDialog() {
      cartDialog.classList.remove('is-visible');
      const onEnd = () => {
        cartDialog.close();
        cartDialog.removeEventListener('transitionend', onEnd);
      };
      cartDialog.addEventListener('transitionend', onEnd);
      setTimeout(() => {
        if (cartDialog.open) cartDialog.close();
      }, 400);
    }

    cartBar.addEventListener('click', () => {
      // Terug naar de mandje-weergave, mocht de vorige keer geëindigd zijn
      // op het bevestigingsscherm van een net verstuurde bestelling.
      viewSuccess?.setAttribute('hidden', '');
      viewItems?.removeAttribute('hidden');
      renderCartItems();
      openCartDialog();
    });
    cartDialog.querySelectorAll('[data-cart-close]').forEach((btn) => btn.addEventListener('click', closeCartDialog));
    cartDialog.querySelector('[data-cart-success-close]')?.addEventListener('click', closeCartDialog);

    // Alles-in-1x wissen: hergebruikt ook ná een geslaagde verzending
    // hieronder (zelfde opruim-logica, of het nu de gast zelf is die het
    // mandje leegt, of de app die het leegt nadat de bestelling weg is).
    function resetCart() {
      cart.clear();
      renderBar();
      document.querySelectorAll<HTMLElement>('[data-qty-stepper]').forEach((stepper) => {
        stepper.dataset.qty = '0';
        const v = stepper.querySelector<HTMLElement>('[data-qty-value]');
        if (v) v.textContent = '0';
      });
      if (tableInput) tableInput.value = '';
      if (notesInput) notesInput.value = '';
      renderCartItems();
    }

    const clearAllBtn = cartDialog.querySelector<HTMLButtonElement>('[data-cart-clear-all]');
    clearAllBtn?.addEventListener('click', () => {
      if (cart.size === 0) return;
      const msg = clearAllBtn.dataset.confirmMsg || 'Empty the whole cart?';
      if (window.confirm(msg)) resetCart();
    });
    cartDialog.addEventListener('click', (e) => {
      if (e.target === cartDialog) closeCartDialog();
    });
    cartDialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeCartDialog();
    });

    // Versturen naar het personeelsscherm.
    submitBtn?.addEventListener('click', async () => {
      const tableNumber = tableInput?.value.trim() ?? '';
      if (!tableNumber) {
        tableError?.removeAttribute('hidden');
        tableInput?.focus();
        return;
      }
      tableError?.setAttribute('hidden', '');
      submitError?.setAttribute('hidden', '');

      const lines = Array.from(cart.values());
      if (lines.length === 0) return;

      submitBtn.disabled = true;
      if (submitLabel) submitLabel.textContent = submitBtn.dataset.sendingLabel ?? submitLabel.textContent;

      const items = lines.map((line) => ({
        name: line.name,
        quantity: line.qty,
        unitPrice: line.unitPrice,
        lineTotal: line.unitPrice * line.qty,
      }));

      // "Table N" bewust altijd in dit neutrale/Franse formaat, ongeacht de
      // taal van de gast — dit veld is voor het PERSONEEL leesbaar op het
      // scherm (dat zelf Frans/Engels labelt), niet voor de gast, dus geen
      // Arabische tekst die het personeel daar niet per se kan lezen.
      //
      // customer_name ÉN customer_phone mogen in de `orders`-tabel NIET
      // leeg (NULL) zijn — twee losse NOT NULL-constraints, allebei pas
      // ontdekt via echte 400-fouten in productie tijdens het testen. De
      // order-site raakt dit blijkbaar nooit (orderSync.ts stuurt daar óók
      // gewoon `null` als een veld leeg is — een sluimerende bug die
      // simpelweg nog nooit is geraakt, waarschijnlijk omdat klanten daar
      // in de praktijk altijd een telefoonnummer invullen), maar de
      // kaart-pagina heeft bewust geen naam/telefoon-veld — dus hier moet
      // expliciet een lege string ('') i.p.v. `null` mee, dat voldoet wél
      // aan "niet leeg" zonder de gast iets extra te laten invullen.
      // customer_name krijgt daarnaast bewust "Table N": het personeels-
      // scherm gebruikt dat veld als KAARTTITEL van elke bestelling, dus
      // dit is niet alleen de workaround voor de constraint, maar ook
      // precies wat het personeel als eerste wil zien.
      const tableLabel = `Table ${tableNumber}`;
      const payload = {
        order_type: 'dinein',
        customer_name: tableLabel,
        customer_phone: '',
        address_or_table: tableLabel,
        // Zelfde voorzorg als hierboven bij customer_phone: '' i.p.v. null
        // voor het geval deze kolom ook een NOT NULL-constraint blijkt te
        // hebben (nog niet apart bevestigd, maar gezien de twee vorige
        // verrassingen hier geen derde testronde voor riskeren).
        special_notes: notesInput?.value.trim() || '',
        items,
        total: cartTotal(),
      };

      try {
        const res = await fetch(`${CARTE_ORDER_SUPABASE_URL}/rest/v1/orders`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: CARTE_ORDER_SUPABASE_ANON_KEY,
            Authorization: `Bearer ${CARTE_ORDER_SUPABASE_ANON_KEY}`,
            Prefer: 'return=minimal',
          },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(`carte order: Supabase insert failed (${res.status})`);

        resetCart();
        viewItems?.setAttribute('hidden', '');
        viewSuccess?.removeAttribute('hidden');
      } catch (err) {
        console.error('carte order: failed to send order to staff screen', err);
        submitError?.removeAttribute('hidden');
      } finally {
        submitBtn.disabled = false;
        if (submitLabel) submitLabel.textContent = submitBtn.dataset.submitLabel ?? submitLabel.textContent;
      }
    });
  }

  document.addEventListener('astro:page-load', setupCarteCart);
</script>
