---
// Standalone owner dashboard. Deliberately NOT using the public Layout (no
// header/nav/footer, no i18n) — this mirrors how caisse.html and the
// foodcost dashboard are built: a single self-contained page with its own
// Supabase-backed auth gate, separate from the marketing site's chrome.
// Read-only: every query here is a SELECT, nothing is ever written back.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
<meta name="robots" content="noindex, nofollow" />
<title>Indian Flavors — Owner</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍛</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&family=Bodoni+Moda:ital,wght@0,500;0,700;0,800&display=swap" rel="stylesheet">
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<style is:global>
  :root{
    --gold:#c9a24b;--gold-light:#e6c878;--orange:#a67c2e;--orange-light:#d4af6a;
    --bg:#14100c;--bg-2:#1c1611;--panel:#211a14;--panel-2:#2a221a;--panel-3:#332920;
    --border:#3d3123;--border-light:#4a3c2c;--text:#f5ecdd;--text-dim:#b8a98f;--text-dimmer:#8a7b64;
    --red:#c25a45;--green:#4a9c62;--blue:#5b7ac9;
    --shadow:0 20px 50px rgba(0,0,0,.45);
    font-family:Inter,Segoe UI,system-ui,-apple-system,sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;background:var(--bg);color:var(--text);min-height:100vh;}
  a{color:inherit;}
  h1,h2{font-family:"Bodoni Moda",serif;}

  /* --- login --- */
  .login-screen{
    min-height:100vh;display:flex;align-items:center;justify-content:center;
    background:
      radial-gradient(circle at 20% 15%, rgba(212,175,106,.10) 0%, transparent 45%),
      radial-gradient(circle at 82% 78%, rgba(201,162,75,.14) 0%, transparent 50%),
      radial-gradient(circle at 50% 30%, #241d16 0%, var(--bg) 70%);
    padding:20px;
  }
  .login-box{
    background:linear-gradient(180deg, var(--panel) 0%, var(--bg-2) 100%);
    border:1px solid var(--border-light);border-radius:20px;
    padding:40px 34px 32px;width:380px;max-width:100%;text-align:center;box-shadow:var(--shadow);
  }
  .login-box .emoji{font-size:34px;margin-bottom:6px;}
  .login-box h1{font-size:22px;color:var(--gold-light);margin:0 0 4px;font-weight:700;}
  .login-box p.sub{font-size:13px;color:var(--text-dimmer);margin:0 0 26px;}
  .field-input{
    width:100%;padding:12px 14px;border-radius:10px;border:1px solid var(--border);
    background:var(--panel-2);color:var(--text);font-size:14px;font-family:inherit;margin-bottom:10px;
  }
  .field-input:focus{outline:none;border-color:var(--gold);}
  .btn-gold{
    width:100%;padding:13px;border-radius:10px;border:none;
    background:linear-gradient(135deg, var(--gold) 0%, var(--orange) 130%);
    color:#1a140d;font-weight:800;font-size:14px;font-family:inherit;cursor:pointer;margin-top:4px;
  }
  .btn-gold:disabled{opacity:.6;cursor:default;}
  .login-error{color:#e08a7d;font-size:13px;margin-top:12px;min-height:1em;}

  /* --- app shell --- */
  #app{display:none;min-height:100vh;}
  header{
    display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;
    padding:16px 28px;border-bottom:2px solid var(--gold);background:#1c1611d1;
    backdrop-filter:blur(14px);position:sticky;top:0;z-index:20;
  }
  .brand{display:flex;align-items:center;gap:10px;}
  .brand-title{font-size:19px;font-weight:700;color:var(--gold-light);}
  .brand-sub{font-size:11px;letter-spacing:.1em;color:var(--gold);text-transform:uppercase;font-weight:700;}
  .header-right{display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
  .range-controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .preset-btn{
    font-size:12.5px;padding:7px 12px;border-radius:8px;border:1px solid var(--border-light);
    background:transparent;color:var(--text-dim);cursor:pointer;font-family:inherit;
  }
  .preset-btn.active{background:var(--gold);border-color:var(--gold);color:#1a140d;font-weight:700;}
  .range-controls input{
    background:var(--panel);border:1px solid var(--border);border-radius:8px;
    padding:6px 8px;color:var(--text);font-size:12.5px;font-family:inherit;
  }
  .signout-btn{
    background:transparent;border:1px solid var(--border);color:var(--text-dim);
    padding:8px 14px;border-radius:9px;cursor:pointer;font-size:13px;font-family:inherit;
  }
  .signout-btn:hover{border-color:var(--gold);color:var(--gold-light);}

  main{max-width:1180px;margin:0 auto;padding:26px 24px 60px;}
  .section-title{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-dimmer);margin:32px 0 12px;}
  .section-title:first-child{margin-top:0;}

  /* KPI hero */
  .kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:16px;overflow:hidden;box-shadow:0 4px 20px #00000040;}
  .kpi-card{background:linear-gradient(180deg, var(--panel) 0%, var(--panel-2) 100%);padding:20px 22px;}
  .kpi-label{font-size:11px;color:var(--text-dimmer);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px;}
  .kpi-value{font-family:"Outfit",sans-serif;font-size:26px;font-weight:800;color:var(--gold-light);font-variant-numeric:tabular-nums;}
  .kpi-delta{font-size:12px;margin-top:6px;font-weight:700;display:inline-flex;align-items:center;gap:3px;}
  .kpi-delta.up{color:var(--green);}
  .kpi-delta.down{color:#e08a7d;}
  .kpi-delta.flat{color:var(--text-dimmer);}

  .panel{background:linear-gradient(180deg, var(--panel) 0%, var(--panel-2) 100%);border:1px solid var(--border);border-radius:14px;box-shadow:0 4px 14px #00000033;}

  /* chart */
  .chart-panel{padding:20px 22px 12px;}
  .chart-wrap{position:relative;}
  #revenueChart{width:100%;height:220px;display:block;overflow:visible;}
  .chart-bar{fill:var(--gold);opacity:.85;cursor:pointer;transition:opacity .1s;}
  .chart-bar:hover{opacity:1;}
  .chart-tooltip{
    position:absolute;pointer-events:none;background:var(--bg-2);border:1px solid var(--gold);
    border-radius:8px;padding:6px 10px;font-size:12px;color:var(--text);white-space:nowrap;
    transform:translate(-50%,-115%);opacity:0;transition:opacity .1s;box-shadow:var(--shadow);z-index:5;
  }
  .chart-tooltip.show{opacity:1;}
  .chart-axis-label{font-size:10px;fill:var(--text-dimmer);}
  /* Real HTML labels below the SVG — the SVG uses preserveAspectRatio="none"
     so its own <text> gets squashed horizontally on narrow screens (viewBox
     units don't scale 1:1 with physical pixels once width and height scale
     differently). Rendering labels as normal DOM text keeps them legible at
     any viewport width. */
  .chart-labels{display:flex;margin-top:2px;}
  /* Each span is one day-wide flex cell so spacing lines up with the bars,
     but most cells are empty (see labelEvery in drawChart) — the text in a
     labeled cell is allowed to visually overflow into its empty neighbors
     rather than being clipped to its own sliver of a cell, which matters a
     lot on narrow phones where a month view can be 30+ cells wide. */
  .chart-labels span{flex:1;position:relative;height:1.2em;font-size:10.5px;color:var(--text-dimmer);}
  .chart-labels span::after{content:attr(data-label);position:absolute;left:50%;top:0;transform:translateX(-50%);white-space:nowrap;}

  /* channel bars */
  .channel-row{display:flex;align-items:center;gap:12px;padding:9px 0;}
  .channel-name{width:150px;flex-shrink:0;font-size:13px;color:var(--text-dim);}
  .channel-bar-track{flex:1;background:var(--panel-3);border-radius:6px;height:10px;overflow:hidden;}
  .channel-bar-fill{height:100%;background:linear-gradient(90deg, var(--orange) 0%, var(--gold) 100%);border-radius:6px;}
  .channel-value{width:130px;flex-shrink:0;text-align:right;font-size:13px;font-weight:700;color:var(--gold-light);}

  /* tables */
  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
  @media (max-width:820px){ .two-col{grid-template-columns:1fr;} }
  .gold-table{width:100%;border-collapse:collapse;}
  .gold-table th{text-align:left;font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-dimmer);padding:10px 14px;border-bottom:1px solid var(--border-light);}
  .gold-table td{padding:10px 14px;border-bottom:1px solid var(--border);font-size:13px;vertical-align:middle;}
  .gold-table tr:last-child td{border-bottom:none;}
  .badge-pill{display:inline-block;font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;}
  .badge-pill.high{background:#4a2f2c;color:#e08a7d;}
  .badge-pill.ok{background:#23402f;color:#a9e0b8;}
  .empty-note{color:var(--text-dimmer);font-size:13px;padding:16px 14px;}

  .loading{padding:60px 0;text-align:center;color:var(--text-dimmer);font-size:14px;}

  /* --- mobile --- */
  @media (max-width:640px){
    .login-box{padding:32px 22px 26px;}
    header{padding:12px 16px;gap:10px;}
    .brand-title{font-size:17px;}
    main{padding:18px 14px 44px;}
    .section-title{font-size:12px;margin:26px 0 10px;}
    .kpi-card{padding:16px 16px;}
    .kpi-value{font-size:22px;}
    .chart-panel{padding:14px 12px 8px;}
    #revenueChart{height:170px;}
    .channel-row{flex-wrap:wrap;gap:4px 10px;padding:11px 0;}
    .channel-name{width:auto;flex:1 1 auto;order:1;}
    .channel-value{width:auto;order:2;}
    .channel-bar-track{flex-basis:100%;order:3;}
    .gold-table th,.gold-table td{padding:9px 10px;font-size:12.5px;}
    .header-right{width:100%;justify-content:flex-start;}
    .range-controls{width:100%;}
    .range-controls input[type="date"]{flex:1;min-width:0;}
    .signout-btn{margin-left:auto;}
  }
</style>
</head>
<body>

  <div class="login-screen" id="loginScreen">
    <div class="login-box">
      <div class="emoji">🔑</div>
      <h1>Owner Access</h1>
      <p class="sub">Sign in to see revenue, top dishes and purchasing at a glance.</p>
      <input class="field-input" id="loginEmail" type="email" placeholder="Email" autocomplete="username" />
      <input class="field-input" id="loginPassword" type="password" placeholder="Password" autocomplete="current-password" />
      <button class="btn-gold" id="loginBtn">Sign in</button>
      <div class="login-error" id="loginError"></div>
    </div>
  </div>

  <div id="app">
    <header>
      <div class="brand">
        <div>
          <div class="brand-title">Indian Flavors</div>
          <div class="brand-sub">Owner Overview</div>
        </div>
      </div>
      <div class="header-right">
        <div class="range-controls" id="presets">
          <div class="preset-btn" data-preset="today">Today</div>
          <div class="preset-btn" data-preset="week">This week</div>
          <div class="preset-btn active" data-preset="month">This month</div>
          <div class="preset-btn" data-preset="last30">Last 30 days</div>
        </div>
        <div class="range-controls">
          <input type="date" id="rangeFrom" />
          <span style="color:var(--text-dimmer);">&rarr;</span>
          <input type="date" id="rangeTo" />
        </div>
        <button class="signout-btn" id="signOutBtn">Sign out</button>
      </div>
    </header>

    <main>
      <div id="content">
        <div class="loading">Loading...</div>
      </div>

      <div class="section-title" style="margin-top:40px;">Winstdeling &mdash; Amplify</div>
      <div class="panel" id="profitLocked" style="padding:22px 24px;">
        <p style="margin:0 0 14px;color:var(--text-dim);font-size:13px;">Dit onderdeel bevat de nettowinst-berekening en het Amplify-aandeel. Log in met het aparte financi&euml;le account om het te bekijken.</p>
        <input class="field-input" id="profitEmail" type="email" placeholder="Email" autocomplete="username" style="max-width:320px;" />
        <input class="field-input" id="profitPassword" type="password" placeholder="Wachtwoord" autocomplete="current-password" style="max-width:320px;" />
        <button class="btn-gold" id="profitUnlockBtn" style="max-width:200px;">Ontgrendel</button>
        <div class="login-error" id="profitLoginError"></div>
      </div>

      <div id="profitSection" style="display:none;">
        <div class="panel" style="padding:16px 20px;margin:18px 0;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <label style="font-size:12.5px;color:var(--text-dim);">Maand</label>
            <input type="month" id="profitMonth" style="background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:6px 8px;color:var(--text);font-size:12.5px;font-family:inherit;" />
          </div>
          <button class="signout-btn" id="profitLockBtn">Vergrendel</button>
        </div>
        <div id="profitContent"><div class="loading">Loading...</div></div>
      </div>
    </main>
  </div>

<script is:inline>
  const SUPABASE_URL = "https://zzdiibzoalmymgbztepf.supabase.co";
  const SUPABASE_KEY = "sb_publishable_96be9YWDCuHOD9-rmGVkeg_5RTW8Jx7";
  const VAT_RATE = 0.10;
  const HIGH_FOOD_COST = 33;

  // @ts-ignore — loaded from CDN script tag above
  const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

  function money(n) {
    return Number(n || 0).toFixed(2) + " DH";
  }
  function pct(n) {
    return Number(n || 0).toFixed(1) + "%";
  }
  function escapeHtml(s) {
    return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }
  function isoDate(d) {
    return d.toISOString().slice(0, 10);
  }
  function startOfDay(dateStr) {
    return new Date(`${dateStr}T00:00:00`);
  }
  function endOfDay(dateStr) {
    return new Date(`${dateStr}T23:59:59`);
  }

  // ---------------------------------------------------------------------
  // Auth
  // ---------------------------------------------------------------------
  async function checkSession() {
    const { data } = await supabaseClient.auth.getSession();
    if (data.session) {
      showApp();
    } else {
      document.getElementById("loginScreen").style.display = "flex";
    }
  }

  function showApp() {
    document.getElementById("loginScreen").style.display = "none";
    document.getElementById("app").style.display = "block";
    setPreset("month");
    checkProfitSession();
  }

  document.getElementById("loginBtn").onclick = async () => {
    const email = document.getElementById("loginEmail").value.trim();
    const password = document.getElementById("loginPassword").value;
    const errEl = document.getElementById("loginError");
    const btn = document.getElementById("loginBtn");
    if (!email || !password) {
      errEl.textContent = "Enter your email and password.";
      return;
    }
    btn.disabled = true;
    btn.textContent = "Signing in...";
    errEl.textContent = "";
    const { error } = await supabaseClient.auth.signInWithPassword({ email, password });
    btn.disabled = false;
    btn.textContent = "Sign in";
    if (error) {
      errEl.textContent = "Incorrect email or password.";
      return;
    }
    showApp();
  };
  document.getElementById("loginPassword").addEventListener("keydown", (e) => {
    if (e.key === "Enter") document.getElementById("loginBtn").click();
  });

  document.getElementById("signOutBtn").onclick = async () => {
    await supabaseClient.auth.signOut();
    document.getElementById("app").style.display = "none";
    document.getElementById("loginScreen").style.display = "flex";
  };

  // ---------------------------------------------------------------------
  // Date range presets
  // ---------------------------------------------------------------------
  function setPreset(key) {
    const now = new Date();
    let from, to;
    if (key === "today") {
      from = to = now;
    } else if (key === "week") {
      const day = (now.getDay() + 6) % 7; // Monday-start week
      from = new Date(now);
      from.setDate(now.getDate() - day);
      to = now;
    } else if (key === "last30") {
      from = new Date(now);
      from.setDate(now.getDate() - 29);
      to = now;
    } else {
      from = new Date(now.getFullYear(), now.getMonth(), 1);
      to = now;
    }
    document.getElementById("rangeFrom").value = isoDate(from);
    document.getElementById("rangeTo").value = isoDate(to);
    document.querySelectorAll(".preset-btn").forEach((b) => {
      b.classList.toggle("active", b.dataset.preset === key);
    });
    loadDashboard();
  }

  document.querySelectorAll(".preset-btn").forEach((b) => {
    b.onclick = () => setPreset(b.dataset.preset);
  });
  ["rangeFrom", "rangeTo"].forEach((id) => {
    document.getElementById(id).addEventListener("change", () => {
      document.querySelectorAll(".preset-btn").forEach((b) => b.classList.remove("active"));
      loadDashboard();
    });
  });

  // ---------------------------------------------------------------------
  // Data helpers — mirrors the matching logic used in caisse.html and the
  // foodcost dashboard: a line item is linked to its dish primarily by
  // dish_id, falling back to a case-insensitive name match for orders
  // placed before dish_id linking existed.
  // ---------------------------------------------------------------------
  function itemQty(it) {
    return Number(it.quantity || it.qty || 1) || 0;
  }
  function resolveDishId(it, dishById, dishIdByNameLower) {
    if (it.dish_id && dishById.has(it.dish_id)) return it.dish_id;
    const nameLower = String(it.name || "").trim().toLowerCase();
    return dishIdByNameLower.get(nameLower) || null;
  }
  function isManualEntry(o) {
    const n = (o.customer_name || "").trim();
    return n.startsWith("Manual entry") || n.startsWith("Saisie manuelle");
  }
  function classifyChannel(o) {
    const name = (o.customer_name || "").trim();
    if (isManualEntry(o)) return "Manual entry";
    if (name.toUpperCase().startsWith("GLOVO")) return "Glovo";
    if (name.startsWith("Dining Room (POS)") || name.startsWith("Salle (Caisse)")) return "Dining Room";
    if (name.startsWith("Counter (POS)") || name.startsWith("Comptoir (Caisse)")) return "Counter";
    return "Website / Other";
  }

  async function fetchOrders(since, until) {
    const { data, error } = await supabaseClient
      .from("orders")
      .select("id,order_type,customer_name,items,total,status,created_at,payment_method")
      .gte("created_at", since.toISOString())
      .lte("created_at", until.toISOString())
      .order("created_at", { ascending: true });
    if (error) throw error;
    return data || [];
  }

  // ---------------------------------------------------------------------
  // Main load
  // ---------------------------------------------------------------------
  let loadToken = 0;

  async function loadDashboard() {
    const myToken = ++loadToken;
    const content = document.getElementById("content");
    content.innerHTML = '<div class="loading">Loading...</div>';

    const fromVal = document.getElementById("rangeFrom").value;
    const toVal = document.getElementById("rangeTo").value;
    if (!fromVal || !toVal) return;
    const since = startOfDay(fromVal);
    const until = endOfDay(toVal);

    const spanMs = until.getTime() - since.getTime();
    const prevUntil = new Date(since.getTime() - 1000);
    const prevSince = new Date(prevUntil.getTime() - spanMs);

    try {
      const [orders, prevOrders, { data: dishes }, { data: ingredients }, { data: recipeLines }, intake, waste] =
        await Promise.all([
          fetchOrders(since, until),
          fetchOrders(prevSince, prevUntil),
          supabaseClient.from("dishes").select("*"),
          supabaseClient.from("ingredients").select("*"),
          supabaseClient.from("recipe_ingredients").select("dish_id,ingredient_id,quantity"),
          supabaseClient.from("stock_intake").select("total_cost,date").gte("date", fromVal).lte("date", toVal),
          supabaseClient.from("waste_log").select("cost_impact,date").gte("date", fromVal).lte("date", toVal),
        ]);

      if (myToken !== loadToken) return; // a newer range was selected meanwhile

      render({
        orders,
        prevOrders,
        dishes: dishes || [],
        ingredients: ingredients || [],
        recipeLines: recipeLines || [],
        intake: intake.data || [],
        waste: waste.data || [],
        since,
        until,
      });
    } catch (e) {
      content.innerHTML = '<div class="loading">Could not load data for this period.</div>';
    }
  }

  function deltaBadge(current, previous) {
    if (!previous) return '<span class="kpi-delta flat">no prior data</span>';
    const change = ((current - previous) / previous) * 100;
    if (Math.abs(change) < 0.5) return '<span class="kpi-delta flat">flat vs prior period</span>';
    const cls = change > 0 ? "up" : "down";
    const arrow = change > 0 ? "&uarr;" : "&darr;";
    return `<span class="kpi-delta ${cls}">${arrow} ${Math.abs(change).toFixed(1)}% vs prior period</span>`;
  }

  function render(d) {
    const dishById = new Map(d.dishes.map((x) => [x.id, x]));
    const dishIdByNameLower = new Map(d.dishes.map((x) => [String(x.name || "").trim().toLowerCase(), x.id]));
    const ingredientById = new Map(d.ingredients.map((x) => [x.id, x]));
    const recipeByDish = new Map();
    d.recipeLines.forEach((r) => {
      if (!recipeByDish.has(r.dish_id)) recipeByDish.set(r.dish_id, []);
      recipeByDish.get(r.dish_id).push(r);
    });

    function dishCost(dishId) {
      const lines = recipeByDish.get(dishId);
      if (!lines || !lines.length) return null;
      return lines.reduce((sum, r) => {
        const ing = ingredientById.get(r.ingredient_id);
        return sum + Number(r.quantity || 0) * (ing ? Number(ing.cost_per_unit || 0) : 0);
      }, 0);
    }

    const valid = d.orders.filter((o) => o.status !== "cancelled");
    const prevValid = d.prevOrders.filter((o) => o.status !== "cancelled");

    const revenue = valid.reduce((s, o) => s + Number(o.total || 0), 0);
    const prevRevenue = prevValid.reduce((s, o) => s + Number(o.total || 0), 0);
    const orderCount = valid.length;
    const prevOrderCount = prevValid.length;
    const avgBasket = orderCount ? revenue / orderCount : 0;
    const prevAvgBasket = prevOrderCount ? prevRevenue / prevOrderCount : 0;

    // daily revenue series
    const byDay = new Map();
    valid.forEach((o) => {
      const day = o.created_at.slice(0, 10);
      byDay.set(day, (byDay.get(day) || 0) + Number(o.total || 0));
    });
    const dayKeys = Array.from(byDay.keys()).sort();

    // channel breakdown
    const byChannel = new Map();
    valid.forEach((o) => {
      const ch = classifyChannel(o);
      byChannel.set(ch, (byChannel.get(ch) || 0) + Number(o.total || 0));
    });
    const channelRows = Array.from(byChannel.entries()).sort((a, b) => b[1] - a[1]);

    // per-dish sales + food cost
    const salesByDish = new Map();
    valid.forEach((o) => {
      const items = Array.isArray(o.items) ? o.items : [];
      items.forEach((it) => {
        const qty = itemQty(it);
        if (!qty) return;
        const dishId = resolveDishId(it, dishById, dishIdByNameLower);
        const name = (dishId && dishById.get(dishId)?.name) || it.name || "(unnamed)";
        const key = dishId || `name:${name.toLowerCase()}`;
        const price = Number(it.price || 0);
        const existing = salesByDish.get(key);
        if (existing) {
          existing.qty += qty;
          existing.revenue += price * qty;
        } else {
          salesByDish.set(key, { dishId, name, qty, revenue: price * qty });
        }
      });
    });
    const topDishes = Array.from(salesByDish.values()).sort((a, b) => b.revenue - a.revenue).slice(0, 8);

    const attention = [];
    d.dishes.forEach((dish) => {
      const cost = dishCost(dish.id);
      if (cost == null || dish.menu_price == null || !dish.menu_price) return;
      const fcPct = (cost / dish.menu_price) * 100;
      if (fcPct > HIGH_FOOD_COST) attention.push({ name: dish.name, fcPct, cost, price: dish.menu_price });
    });
    attention.sort((a, b) => b.fcPct - a.fcPct);

    // theoretical ingredient cost for the period (same logic as Purchasing page)
    let theoreticalCost = 0;
    valid.forEach((o) => {
      const items = Array.isArray(o.items) ? o.items : [];
      items.forEach((it) => {
        const qty = itemQty(it);
        if (!qty) return;
        const dishId = resolveDishId(it, dishById, dishIdByNameLower);
        if (!dishId) return;
        const lines = recipeByDish.get(dishId);
        if (!lines) return;
        lines.forEach((r) => {
          const ing = ingredientById.get(r.ingredient_id);
          if (!ing) return;
          theoreticalCost += Number(r.quantity || 0) * qty * Number(ing.cost_per_unit || 0);
        });
      });
    });
    const actualPurchases = d.intake.reduce((s, r) => s + Number(r.total_cost || 0), 0);
    const wasteTotal = d.waste.reduce((s, r) => s + Number(r.cost_impact || 0), 0);

    const avgFoodCostPct = (() => {
      const withCost = d.dishes
        .map((dish) => {
          const cost = dishCost(dish.id);
          return cost != null && dish.menu_price ? (cost / dish.menu_price) * 100 : null;
        })
        .filter((v) => v != null);
      if (!withCost.length) return null;
      return withCost.reduce((s, v) => s + v, 0) / withCost.length;
    })();

    const maxDay = Math.max(1, ...dayKeys.map((k) => byDay.get(k)));

    const html = `
      <div class="section-title">Overview</div>
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-label">Revenue</div>
          <div class="kpi-value">${money(revenue)}</div>
          ${deltaBadge(revenue, prevRevenue)}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Orders</div>
          <div class="kpi-value">${orderCount}</div>
          ${deltaBadge(orderCount, prevOrderCount)}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Avg. basket</div>
          <div class="kpi-value">${money(avgBasket)}</div>
          ${deltaBadge(avgBasket, prevAvgBasket)}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Avg. food cost %</div>
          <div class="kpi-value">${avgFoodCostPct != null ? pct(avgFoodCostPct) : "-"}</div>
          <span class="kpi-delta flat">across ${d.dishes.length} dishes on the menu</span>
        </div>
      </div>

      <div class="section-title">Revenue by day</div>
      <div class="panel chart-panel">
        <div class="chart-wrap">
          <svg id="revenueChart" viewBox="0 0 1000 200" preserveAspectRatio="none"></svg>
          <div class="chart-labels" id="chartLabels"></div>
          <div class="chart-tooltip" id="chartTooltip"></div>
        </div>
      </div>

      <div class="two-col">
        <div>
          <div class="section-title">Revenue by channel</div>
          <div class="panel" style="padding:16px 20px;">
            ${
              channelRows.length
                ? channelRows
                    .map(
                      ([name, rev]) => `
                <div class="channel-row">
                  <div class="channel-name">${escapeHtml(name)}</div>
                  <div class="channel-bar-track"><div class="channel-bar-fill" style="width:${revenue ? (rev / revenue) * 100 : 0}%;"></div></div>
                  <div class="channel-value">${money(rev)}</div>
                </div>`
                    )
                    .join("")
                : '<div class="empty-note">No orders in this period.</div>'
            }
          </div>
        </div>
        <div>
          <div class="section-title">Needs attention &middot; food cost &gt; ${HIGH_FOOD_COST}%</div>
          <div class="panel" style="overflow:hidden;">
            ${
              attention.length
                ? `<table class="gold-table"><tbody>` +
                  attention
                    .slice(0, 8)
                    .map(
                      (a) => `
                    <tr>
                      <td>${escapeHtml(a.name)}</td>
                      <td style="text-align:right;"><span class="badge-pill high">${pct(a.fcPct)}</span></td>
                    </tr>`
                    )
                    .join("") +
                  `</tbody></table>`
                : '<div class="empty-note">Nothing above the threshold right now.</div>'
            }
          </div>
        </div>
      </div>

      <div class="section-title">Top dishes this period</div>
      <div class="panel" style="overflow-x:auto;">
        <table class="gold-table">
          <thead><tr><th>Dish</th><th>Qty sold</th><th>Revenue</th></tr></thead>
          <tbody>
            ${
              topDishes.length
                ? topDishes
                    .map(
                      (t) => `
                <tr>
                  <td>${escapeHtml(t.name)}</td>
                  <td>${t.qty}</td>
                  <td style="color:var(--gold-light);font-weight:700;">${money(t.revenue)}</td>
                </tr>`
                    )
                    .join("")
                : `<tr><td colspan="3" class="empty-note">No sales in this period.</td></tr>`
            }
          </tbody>
        </table>
      </div>

      <div class="section-title">Purchasing &amp; waste</div>
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-label">Theoretical ingredient cost</div>
          <div class="kpi-value">${money(theoreticalCost)}</div>
          <span class="kpi-delta flat">what sales should have consumed</span>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Actual purchases logged</div>
          <div class="kpi-value">${d.intake.length ? money(actualPurchases) : "-"}</div>
          <span class="kpi-delta flat">${d.intake.length ? "from Log &rarr; Intake" : "nothing logged yet for this period"}</span>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Waste logged</div>
          <div class="kpi-value">${d.waste.length ? money(wasteTotal) : "-"}</div>
          <span class="kpi-delta flat">${d.waste.length ? "from Log &rarr; Waste" : "nothing logged yet for this period"}</span>
        </div>
      </div>
    `;

    document.getElementById("content").innerHTML = html;
    drawChart(dayKeys, byDay, maxDay);
  }

  // ---------------------------------------------------------------------
  // Minimal bar chart: one series (daily revenue), gold fill, per-bar
  // hover tooltip. No legend needed for a single series.
  // ---------------------------------------------------------------------
  function drawChart(dayKeys, byDay, maxDay) {
    const svg = document.getElementById("revenueChart");
    const tooltip = document.getElementById("chartTooltip");
    const labelsRow = document.getElementById("chartLabels");
    if (!svg) return;
    svg.innerHTML = "";
    if (labelsRow) labelsRow.innerHTML = "";
    if (!dayKeys.length) {
      const t = document.createElementNS("http://www.w3.org/2000/svg", "text");
      t.setAttribute("x", "500");
      t.setAttribute("y", "100");
      t.setAttribute("text-anchor", "middle");
      t.setAttribute("class", "chart-axis-label");
      t.textContent = "No revenue in this period";
      svg.appendChild(t);
      return;
    }
    const W = 1000, H = 200, padBottom = 4, padTop = 10;
    const barGap = 3;
    const barW = Math.max(2, W / dayKeys.length - barGap);
    const usableH = H - padBottom - padTop;

    dayKeys.forEach((day, i) => {
      const val = byDay.get(day) || 0;
      const h = maxDay ? (val / maxDay) * usableH : 0;
      const x = i * (W / dayKeys.length);
      const y = H - padBottom - h;
      const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
      rect.setAttribute("x", String(x));
      rect.setAttribute("y", String(y));
      rect.setAttribute("width", String(barW));
      rect.setAttribute("height", String(Math.max(1, h)));
      rect.setAttribute("rx", "3");
      rect.setAttribute("class", "chart-bar");
      const showTooltip = (clientX, clientY) => {
        tooltip.textContent = `${day}: ${money(val)}`;
        tooltip.classList.add("show");
        const wrapRect = svg.parentElement.getBoundingClientRect();
        tooltip.style.left = clientX - wrapRect.left + "px";
        tooltip.style.top = clientY - wrapRect.top + "px";
      };
      rect.addEventListener("mouseenter", (e) => showTooltip(e.clientX, e.clientY));
      rect.addEventListener("mousemove", (e) => showTooltip(e.clientX, e.clientY));
      rect.addEventListener("mouseleave", () => tooltip.classList.remove("show"));
      // Touch devices don't fire hover events — tap a bar to show its
      // tooltip, tap elsewhere on the chart to dismiss it.
      rect.addEventListener(
        "touchstart",
        (e) => {
          e.preventDefault();
          const t = e.touches[0];
          showTooltip(t.clientX, t.clientY);
        },
        { passive: false }
      );
      svg.appendChild(rect);
    });
    svg.addEventListener("touchstart", (e) => {
      if (e.target === svg) tooltip.classList.remove("show");
    });

    // Sparse day labels as real HTML (see .chart-labels comment above) —
    // one flex cell per day so spacing always matches the bars, text only
    // set on every Nth cell to avoid crowding. Fewer labels on narrow phone
    // screens, where each cell has less physical room.
    if (labelsRow) {
      const maxLabels = window.innerWidth < 480 ? 5 : 8;
      const labelEvery = Math.ceil(dayKeys.length / maxLabels);
      dayKeys.forEach((day, i) => {
        const span = document.createElement("span");
        if (i % labelEvery === 0) span.dataset.label = day.slice(5);
        labelsRow.appendChild(span);
      });
    }
  }

  // ---------------------------------------------------------------------
  // Extra login gate: net-profit / profit-sharing overview.
  // Uses a second, independent Supabase Auth client (distinct storageKey)
  // so checking these credentials never touches or replaces the main
  // owner session above — the two logins are fully separate.
  // ---------------------------------------------------------------------
  const CORP_TAX_RATE = 0.175; // vennootschapsbelasting

  // @ts-ignore
  const profitAuthClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY, {
    auth: { storageKey: "sb-profit-gate", persistSession: true },
  });

  async function checkProfitSession() {
    const { data } = await profitAuthClient.auth.getSession();
    if (data.session) {
      document.getElementById("profitLocked").style.display = "none";
      document.getElementById("profitSection").style.display = "block";
      initProfitMonth();
    }
  }

  document.getElementById("profitUnlockBtn").onclick = async () => {
    const email = document.getElementById("profitEmail").value.trim();
    const password = document.getElementById("profitPassword").value;
    const errEl = document.getElementById("profitLoginError");
    const btn = document.getElementById("profitUnlockBtn");
    if (!email || !password) {
      errEl.textContent = "Vul email en wachtwoord in.";
      return;
    }
    btn.disabled = true;
    btn.textContent = "Bezig...";
    errEl.textContent = "";
    const { error } = await profitAuthClient.auth.signInWithPassword({ email, password });
    btn.disabled = false;
    btn.textContent = "Ontgrendel";
    if (error) {
      errEl.textContent = "Onjuiste inloggegevens.";
      return;
    }
    document.getElementById("profitLocked").style.display = "none";
    document.getElementById("profitSection").style.display = "block";
    initProfitMonth();
  };
  document.getElementById("profitPassword").addEventListener("keydown", (e) => {
    if (e.key === "Enter") document.getElementById("profitUnlockBtn").click();
  });

  document.getElementById("profitLockBtn").onclick = async () => {
    await profitAuthClient.auth.signOut();
    document.getElementById("profitSection").style.display = "none";
    document.getElementById("profitLocked").style.display = "block";
    document.getElementById("profitEmail").value = "";
    document.getElementById("profitPassword").value = "";
  };

  function currentPeriodDefault() {
    const now = new Date();
    return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
  }

  function initProfitMonth() {
    const monthInput = document.getElementById("profitMonth");
    if (!monthInput.value) monthInput.value = currentPeriodDefault();
    monthInput.onchange = () => loadProfitMonth(monthInput.value);
    loadProfitMonth(monthInput.value);
  }

  async function loadProfitMonth(period) {
    const container = document.getElementById("profitContent");
    container.innerHTML = '<div class="loading">Loading...</div>';
    const [yearStr, monthStr] = period.split("-");
    const year = Number(yearStr),
      monthIdx = Number(monthStr) - 1;
    const since = new Date(year, monthIdx, 1, 0, 0, 0);
    const until = new Date(year, monthIdx + 1, 0, 23, 59, 59);
    const fromVal = isoDate(since),
      toVal = isoDate(until);

    try {
      const [orders, { data: dishes }, { data: ingredients }, { data: recipeLines }, waste, { data: savedRows }] =
        await Promise.all([
          fetchOrders(since, until),
          supabaseClient.from("dishes").select("*"),
          supabaseClient.from("ingredients").select("*"),
          supabaseClient.from("recipe_ingredients").select("dish_id,ingredient_id,quantity"),
          supabaseClient.from("waste_log").select("cost_impact,date").gte("date", fromVal).lte("date", toVal),
          supabaseClient.from("monthly_finance").select("*").eq("period", period),
        ]);

      const dishById = new Map((dishes || []).map((x) => [x.id, x]));
      const dishIdByNameLower = new Map((dishes || []).map((x) => [String(x.name || "").trim().toLowerCase(), x.id]));
      const ingredientById = new Map((ingredients || []).map((x) => [x.id, x]));
      const recipeByDish = new Map();
      (recipeLines || []).forEach((r) => {
        if (!recipeByDish.has(r.dish_id)) recipeByDish.set(r.dish_id, []);
        recipeByDish.get(r.dish_id).push(r);
      });

      const valid = orders.filter((o) => o.status !== "cancelled");
      const revenueInclVat = valid.reduce((s, o) => s + Number(o.total || 0), 0);

      // Theoretical recipe cost of everything actually sold this month —
      // the "best and fairest" foodcost basis: it ties directly to revenue
      // and isn't skewed by when stock happened to be purchased.
      let theoreticalCost = 0;
      valid.forEach((o) => {
        const items = Array.isArray(o.items) ? o.items : [];
        items.forEach((it) => {
          const qty = itemQty(it);
          if (!qty) return;
          const dishId = resolveDishId(it, dishById, dishIdByNameLower);
          if (!dishId) return;
          const lines = recipeByDish.get(dishId);
          if (!lines) return;
          lines.forEach((r) => {
            const ing = ingredientById.get(r.ingredient_id);
            if (!ing) return;
            theoreticalCost += Number(r.quantity || 0) * qty * Number(ing.cost_per_unit || 0);
          });
        });
      });
      const wasteTotal = (waste.data || []).reduce((s, r) => s + Number(r.cost_impact || 0), 0);

      const saved = (savedRows && savedRows[0]) || null;

      renderProfitUI(period, { revenueInclVat, theoreticalCost, wasteTotal, orderCount: valid.length }, saved);
    } catch (e) {
      container.innerHTML = '<div class="loading">Kon gegevens voor deze maand niet laden.</div>';
    }
  }

  function renderProfitUI(period, data, saved) {
    const container = document.getElementById("profitContent");
    const rent = saved?.rent ?? 28000;
    const payroll = saved?.payroll ?? "";
    const managementFee = saved?.management_fee ?? 3000;
    const otherCosts = saved?.other_costs ?? "";
    const profitSharePct = saved?.profit_share_pct ?? "";

    container.innerHTML = `
      <div class="two-col" style="align-items:start;">
        <div>
          <div class="section-title" style="margin-top:0;">Kosten invoeren</div>
          <div class="panel" style="padding:18px 20px;">
            <label style="display:block;font-size:12px;color:var(--text-dimmer);margin-bottom:4px;">Huur (DH/maand)</label>
            <input class="field-input" id="pfRent" type="number" step="0.01" value="${rent}" />
            <label style="display:block;font-size:12px;color:var(--text-dimmer);margin-bottom:4px;">Loonkosten (DH)</label>
            <input class="field-input" id="pfPayroll" type="number" step="0.01" placeholder="nog invullen" value="${payroll}" />
            <label style="display:block;font-size:12px;color:var(--text-dimmer);margin-bottom:4px;">Management fee aan Amplify (DH)</label>
            <input class="field-input" id="pfManagementFee" type="number" step="0.01" value="${managementFee}" />
            <label style="display:block;font-size:12px;color:var(--text-dimmer);margin-bottom:4px;">Overige kosten (DH)</label>
            <input class="field-input" id="pfOtherCosts" type="number" step="0.01" placeholder="nog invullen" value="${otherCosts}" />
            <p style="font-size:11.5px;color:var(--text-dimmer);margin:-4px 0 12px;">
              Denk aan: Glovo/bezorgcommissie, betaalkosten (kaartbetalingen), verpakking, elektriciteit/water/gas, verzekering, onderhoud/reparaties, marketing, boekhouding, vergunningen.
            </p>
            <label style="display:block;font-size:12px;color:var(--text-dimmer);margin-bottom:4px;">Winstdeel Amplify (%)</label>
            <input class="field-input" id="pfProfitShare" type="number" step="0.1" placeholder="nog te bepalen" value="${profitSharePct}" />
            <button class="btn-gold" id="pfSaveBtn" style="margin-top:4px;">Opslaan</button>
            <div class="login-error" id="pfSaveMsg" style="color:var(--green);"></div>
          </div>
        </div>
        <div>
          <div class="section-title" style="margin-top:0;">Nettowinst &mdash; ${period}</div>
          <div id="profitCalcOut"></div>
        </div>
      </div>
    `;

    ["pfRent", "pfPayroll", "pfManagementFee", "pfOtherCosts", "pfProfitShare"].forEach((id) => {
      document.getElementById(id).addEventListener("input", () => computeAndRenderCalc(data));
    });

    document.getElementById("pfSaveBtn").onclick = async () => {
      const btn = document.getElementById("pfSaveBtn");
      const msg = document.getElementById("pfSaveMsg");
      btn.disabled = true;
      btn.textContent = "Opslaan...";
      const shareVal = document.getElementById("pfProfitShare").value;
      const payload = {
        period,
        rent: Number(document.getElementById("pfRent").value || 0),
        payroll: Number(document.getElementById("pfPayroll").value || 0),
        management_fee: Number(document.getElementById("pfManagementFee").value || 0),
        other_costs: Number(document.getElementById("pfOtherCosts").value || 0),
        profit_share_pct: shareVal === "" ? null : Number(shareVal),
        updated_at: new Date().toISOString(),
      };
      const { error } = await supabaseClient.from("monthly_finance").upsert(payload, { onConflict: "period" });
      btn.disabled = false;
      btn.textContent = "Opslaan";
      msg.textContent = error ? "Opslaan mislukt." : "Opgeslagen.";
      if (!error) setTimeout(() => (msg.textContent = ""), 2500);
    };

    computeAndRenderCalc(data);
  }

  function computeAndRenderCalc(data) {
    const out = document.getElementById("profitCalcOut");
    if (!out) return;
    const rent = Number(document.getElementById("pfRent").value || 0);
    const payroll = Number(document.getElementById("pfPayroll").value || 0);
    const managementFee = Number(document.getElementById("pfManagementFee").value || 0);
    const otherCosts = Number(document.getElementById("pfOtherCosts").value || 0);
    const shareRaw = document.getElementById("pfProfitShare").value;
    const sharePct = shareRaw === "" ? null : Number(shareRaw);

    const revenueInclVat = data.revenueInclVat;
    const revenueExVat = revenueInclVat / (1 + VAT_RATE);
    const vatAmount = revenueInclVat - revenueExVat;
    const foodCost = data.theoreticalCost + data.wasteTotal;
    const grossProfit = revenueExVat - foodCost;
    const operatingCosts = rent + payroll + managementFee + otherCosts;
    const pretaxProfit = grossProfit - operatingCosts;
    const corpTax = pretaxProfit > 0 ? pretaxProfit * CORP_TAX_RATE : 0;
    const netProfit = pretaxProfit - corpTax;
    const amplifyOnPretax = sharePct != null ? (pretaxProfit * sharePct) / 100 : null;
    const amplifyOnNet = sharePct != null ? (netProfit * sharePct) / 100 : null;

    out.innerHTML = `
      <div class="panel" style="padding:0;overflow:hidden;">
        <table class="gold-table">
          <tbody>
            <tr><td>Omzet incl. btw</td><td style="text-align:right;">${money(revenueInclVat)}</td></tr>
            <tr><td>Btw (${pct(VAT_RATE * 100)})</td><td style="text-align:right;color:var(--text-dim);">&minus; ${money(vatAmount)}</td></tr>
            <tr><td><strong>Omzet excl. btw</strong></td><td style="text-align:right;"><strong>${money(revenueExVat)}</strong></td></tr>
            <tr><td>Foodcost (theoretisch + waste)</td><td style="text-align:right;color:var(--red);">&minus; ${money(foodCost)}</td></tr>
            <tr><td><strong>Brutowinst</strong></td><td style="text-align:right;"><strong>${money(grossProfit)}</strong></td></tr>
            <tr><td>Huur</td><td style="text-align:right;color:var(--red);">&minus; ${money(rent)}</td></tr>
            <tr><td>Loonkosten</td><td style="text-align:right;color:var(--red);">&minus; ${money(payroll)}</td></tr>
            <tr><td>Management fee (Amplify)</td><td style="text-align:right;color:var(--red);">&minus; ${money(managementFee)}</td></tr>
            <tr><td>Overige kosten</td><td style="text-align:right;color:var(--red);">&minus; ${money(otherCosts)}</td></tr>
            <tr><td><strong>Winst v&oacute;&oacute;r belasting</strong></td><td style="text-align:right;"><strong>${money(pretaxProfit)}</strong></td></tr>
            <tr><td>Vennootschapsbelasting (${pct(CORP_TAX_RATE * 100)})</td><td style="text-align:right;color:var(--red);">&minus; ${money(corpTax)}</td></tr>
            <tr><td style="font-size:14.5px;"><strong>Nettowinst</strong></td><td style="text-align:right;font-size:14.5px;color:var(--gold-light);"><strong>${money(netProfit)}</strong></td></tr>
          </tbody>
        </table>
      </div>
      <div class="panel" style="padding:16px 20px;margin-top:14px;">
        <div class="kpi-label" style="margin-bottom:10px;">Amplify-aandeel${sharePct != null ? ` (${sharePct}%)` : ""}</div>
        ${
          sharePct != null
            ? `<div style="font-size:13px;color:var(--text-dim);margin-bottom:6px;">Op winst v&oacute;&oacute;r belasting: <strong style="color:var(--gold-light);">${money(amplifyOnPretax)}</strong></div>
               <div style="font-size:13px;color:var(--text-dim);">Op nettowinst: <strong style="color:var(--gold-light);">${money(amplifyOnNet)}</strong></div>`
            : `<div style="font-size:13px;color:var(--text-dimmer);">Percentage nog niet vastgesteld &mdash; wordt na de eerste maand bepaald.</div>`
        }
      </div>
      <p style="font-size:11px;color:var(--text-dimmer);margin-top:14px;">
        Indicatieve berekening, geen fiscaal advies. Foodcost = theoretische receptkost van verkochte gerechten + gelogde waste (${data.orderCount} bestellingen deze maand).
      </p>
    `;
  }

  checkSession();
</script>
</body>
</html>
